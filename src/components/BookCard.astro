---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatPrice } from '../utils/price';

interface Props {
  id: string;
  title: string;
  author: string;
  publisher?: string;
  coverImage: ImageMetadata;
  price?: number;
  /** First cards on a page load eagerly; the rest are lazy. */
  eager?: boolean;
}

const { id, title, author, publisher, coverImage, price, eager = false } = Astro.props;
---

<!-- Shop card: the cover leads, the whole card opens the book page -->
<a href={`/books/${id}/`} class="surface tap group flex flex-col overflow-hidden transition-shadow hover:shadow-[var(--lift-shadow)]">
  <div class="aspect-[2/3] overflow-hidden bg-[var(--reader-border)]">
    <Image
      src={coverImage}
      alt=""
      widths={[160, 240, 320, 400]}
      sizes="(min-width: 640px) 200px, 46vw"
      loading={eager ? 'eager' : 'lazy'}
      class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
    />
  </div>
  <div class="flex flex-1 flex-col p-3">
    <h2 class="line-clamp-2 font-serif text-base font-semibold leading-snug group-hover:accent-text">{title}</h2>
    <p class="mt-1 truncate text-sm text-[var(--reader-muted)]">{author}</p>
    {publisher && <p class="mt-0.5 truncate text-xs text-[var(--reader-muted)]">{publisher}</p>}
    {price !== undefined && <p class="mt-auto pt-2 font-semibold tabular-nums">{formatPrice(price)}</p>}
  </div>
</a>
