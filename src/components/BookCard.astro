---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatPrice } from '../utils/price';
import { listSlug } from '../utils/slug';

interface Props {
  id: string;
  title: string;
  author: string;
  publisher?: string;
  coverImage: ImageMetadata;
  price?: number;
  /** First cards on a page load eagerly; the rest are lazy. */
  eager?: boolean;
}

const { id, title, author, publisher, coverImage, price, eager = false } = Astro.props;
---

<!-- Shop card: cover and title open the book; author and publisher open their own lists.
     (Separate links, so they aren't nested inside one card-wide link.) -->
<article class="surface group flex flex-col overflow-hidden transition-shadow hover:shadow-[var(--lift-shadow)]">
  <a href={`/books/${id}/`} class="block aspect-[2/3] overflow-hidden bg-[var(--reader-border)]" tabindex="-1" aria-hidden="true">
    <Image
      src={coverImage}
      alt=""
      widths={[200, 280, 400, 560]}
      watermark
      sizes="(min-width: 1536px) 270px, (min-width: 1024px) 22vw, (min-width: 640px) 30vw, 46vw"
      loading={eager ? 'eager' : 'lazy'}
      class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
    />
  </a>
  <div class="flex flex-1 flex-col p-3.5 sm:p-4">
    <h2 class="font-serif text-base font-semibold leading-snug sm:text-[1.0625rem]">
      <a href={`/books/${id}/`} class="line-clamp-2 hover:accent-text" title={title}>{title}</a>
    </h2>
    <a href={`/books/author/${listSlug(author)}/`} class="mt-1.5 truncate text-sm text-[var(--reader-muted)] hover:text-[var(--reader-text)] hover:underline">{author}</a>
    {publisher && (
      <a href={`/books/publisher/${listSlug(publisher)}/`} class="mt-0.5 truncate text-xs text-[var(--reader-muted)] hover:text-[var(--reader-text)] hover:underline">{publisher}</a>
    )}
    {price !== undefined && <p class="mt-auto pt-3 font-semibold tabular-nums">{formatPrice(price)}</p>}
  </div>
</article>
