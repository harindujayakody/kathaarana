---
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article' | 'book';
  canonicalUrl?: string;
  publishDate?: Date;
  novel?: {
    title: string;
    author: string;
    coverImage: string;
    synopsis?: string;
    url?: string;
    genres?: string[];
  };
  noindex?: boolean;
  chapter?: {
    number: number;
    title: string;
    wordCount?: number;
  };
}

const {
  title,
  description,
  image = '/og/site.jpg',
  type = 'website',
  canonicalUrl = Astro.url.href,
  publishDate,
  novel,
  chapter,
  noindex = false,
} = Astro.props;

const siteName = 'කතා අරණ';
const siteUrl = Astro.site ? Astro.site.toString() : 'https://kathaarana.com/';
// Short suffix keeps the words that matter visible in search results.
const pageTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const fullImageUrl = new URL(image, siteUrl).toString();

const jsonLdSchemas: any[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    alternateName: 'Katha Arana',
    url: siteUrl,
    inLanguage: 'si',
    description: 'සිංහල නවකතා පරිච්ඡේදයෙන් පරිච්ඡේදය නොමිලේ කියවන්න.',
  },
];

const bookId = novel && novel.url ? `${novel.url}#book` : undefined;

if (novel && !chapter) {
  jsonLdSchemas.push({
    '@context': 'https://schema.org',
    '@type': 'Book',
    '@id': bookId,
    name: novel.title,
    author: { '@type': 'Person', name: novel.author },
    description: novel.synopsis ?? description,
    image: new URL(novel.coverImage, siteUrl).toString(),
    url: novel.url ?? canonicalUrl,
    inLanguage: 'si',
    genre: novel.genres,
  });
}

if (novel && chapter) {
  jsonLdSchemas.push({
    '@context': 'https://schema.org',
    '@type': 'Chapter',
    name: `පරිච්ඡේදය ${chapter.number}: ${chapter.title}`,
    position: chapter.number,
    wordCount: chapter.wordCount,
    inLanguage: 'si',
    isPartOf: {
      '@type': 'Book',
      '@id': bookId,
      name: novel.title,
      author: { '@type': 'Person', name: novel.author },
      url: novel.url ?? siteUrl,
    },
    datePublished: publishDate?.toISOString(),
    url: canonicalUrl,
  });

  jsonLdSchemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: siteName, item: siteUrl },
      { '@type': 'ListItem', position: 2, name: novel.title, item: novel.url ?? siteUrl },
      { '@type': 'ListItem', position: 3, name: `පරිච්ඡේදය ${chapter.number}`, item: canonicalUrl },
    ],
  });
}
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonicalUrl} />}
<link rel="alternate" type="application/rss+xml" title="කතා අරණ - නවතම පරිච්ඡේද" href="/rss.xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#fcfbf9" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0b0f17" media="(prefers-color-scheme: dark)" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type === 'book' || chapter ? 'article' : 'website'} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={novel ? `${novel.title} කවරය` : siteName} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="si_LK" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />

<!-- Structured Data (JSON-LD) for Search Engines -->
{jsonLdSchemas.map(schema => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
