---
import Icon from './Icon.astro';

interface ChapterItem {
  number: number;
  title: string;
  url: string;
  isCurrent: boolean;
}

interface Props {
  novelSlug: string;
  novelTitle: string;
  chapters: ChapterItem[];
  prevUrl?: string;
  nextUrl?: string;
  currentChapterNum: number;
}

const { novelSlug, novelTitle, chapters, prevUrl, nextUrl, currentChapterNum } = Astro.props;

const themes = [
  { id: 'light', label: 'ආලෝකය', swatch: 'bg-white text-[#16181d]' },
  { id: 'sepia', label: 'සීපියා', swatch: 'bg-[#f7f0de] text-[#433422]' },
  { id: 'dark', label: 'අඳුරු', swatch: 'bg-black text-[#ececec]' },
];
const navClass = 'tap flex shrink-0 items-center gap-1 rounded-lg px-2.5 py-2 text-sm font-medium min-[360px]:px-3';
---

<!-- Reader bar: replaces the bottom tabs while reading -->
<div id="reader-bar" class="fixed inset-x-0 bottom-0 z-30 border-t border-[var(--reader-border)] bg-[var(--reader-panel)] pb-[env(safe-area-inset-bottom)] transition-transform duration-200 lg:left-64">
  <div class="h-0.5 bg-[var(--reader-border)]">
    <div id="reading-progress-bar" class="h-full w-0 bg-[var(--theme-accent)]"></div>
  </div>
  <div class="mx-auto flex h-14 max-w-[54rem] items-center justify-between gap-1 px-2">
    {prevUrl ? (
      <a href={prevUrl} id="btn-prev-chap" class={navClass} aria-label="පෙර පරිච්ඡේදය">
        <Icon name="left" /><span class="hidden sm:inline">පෙර</span>
      </a>
    ) : (
      <span class={`${navClass} opacity-30`} aria-hidden="true"><Icon name="left" /><span class="hidden sm:inline">පෙර</span></span>
    )}

    <button type="button" id="btn-open-settings" class={`${navClass} cursor-pointer`} aria-haspopup="dialog">
      <Icon name="list" />
      <span><span class="hidden min-[360px]:inline">පරිච්ඡේදය </span>{currentChapterNum}</span>
    </button>

    <div class="flex items-center">
      <button type="button" id="btn-font-dec" class="tap cursor-pointer whitespace-nowrap rounded-lg px-2 py-2 text-sm font-semibold min-[360px]:px-3" aria-label="A− අකුරු කුඩා කරන්න">A−</button>
      <button type="button" id="btn-font-inc" class="tap cursor-pointer whitespace-nowrap rounded-lg px-2 py-2 text-base font-semibold min-[360px]:px-3" aria-label="A+ අකුරු විශාල කරන්න">A+</button>
    </div>

    <button type="button" data-bookmark aria-pressed="false" class="tap cursor-pointer rounded-lg p-2.5 text-[var(--reader-muted)]" aria-label="මෙම පරිච්ඡේදයට පිටුසනක්">
      <Icon name="bookmark" />
    </button>

    {nextUrl ? (
      <a href={nextUrl} id="btn-next-chap" data-astro-prefetch="load" class={`${navClass} accent-bg`} aria-label="ඊළඟ පරිච්ඡේදය">
        <span class="hidden sm:inline">ඊළඟ</span><Icon name="right" />
      </a>
    ) : (
      <span class={`${navClass} opacity-30`} aria-hidden="true"><span class="hidden sm:inline">ඊළඟ</span><Icon name="right" /></span>
    )}
  </div>
</div>

<!-- Chapters and reading settings: bottom sheet on phones, dialog on larger screens -->
<dialog id="reader-sheet" class="sheet" aria-labelledby="reader-sheet-title">
  <div class="flex max-h-[85dvh] flex-col">
    <div class="flex items-center justify-between gap-3 border-b border-[var(--reader-border)] px-5 py-3">
      <h2 id="reader-sheet-title" class="truncate text-lg font-bold">{novelTitle}</h2>
      <button type="button" id="btn-close-sheet" class="tap -mr-2 cursor-pointer rounded-lg p-2 text-[var(--reader-muted)]" aria-label="වසන්න">
        <Icon name="close" />
      </button>
    </div>

    <div class="space-y-5 overflow-y-auto px-5 py-4">
      <div>
        <h3 class="font-sans text-sm font-semibold text-[var(--reader-muted)]">තේමාව</h3>
        <div class="mt-2 grid grid-cols-3 gap-2">
          {themes.map((theme) => (
            <button type="button" data-set-theme={theme.id} aria-pressed="false" class={`tap cursor-pointer rounded-lg border border-[var(--reader-border)] px-2 py-2.5 text-sm font-medium ${theme.swatch}`}>
              {theme.label}
            </button>
          ))}
        </div>
      </div>

      <div>
        <h3 class="font-sans text-sm font-semibold text-[var(--reader-muted)]">අකුරු මෝස්තරය</h3>
        <div class="mt-2 grid grid-cols-2 gap-2">
          <button type="button" data-font="sans" aria-pressed="false" class="tap cursor-pointer rounded-lg border border-[var(--reader-border)] px-3 py-2.5 text-sm">සරල අකුරු</button>
          <button type="button" data-font="serif" aria-pressed="false" class="tap cursor-pointer rounded-lg border border-[var(--reader-border)] px-3 py-2.5 font-serif text-sm">පොත් අකුරු</button>
        </div>
      </div>

      <div>
        <h3 class="font-sans text-sm font-semibold text-[var(--reader-muted)]">පරිච්ඡේද {chapters.length}</h3>
        <ol class="mt-1 divide-y divide-[var(--reader-border)]">
          {chapters.map((ch) => (
            <li>
              <a
                href={ch.url}
                aria-current={ch.isCurrent ? 'page' : undefined}
                class={`tap flex items-center gap-3 py-2.5 text-[0.9375rem] ${ch.isCurrent ? 'accent-text font-semibold' : ''}`}
              >
                <span class="w-6 shrink-0 text-center tabular-nums text-[var(--reader-muted)]">{ch.number}</span>
                <span class="min-w-0 flex-1 truncate">{ch.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>

      <a href={`/novels/${novelSlug}/`} class="block text-sm font-medium accent-text">නවකතා පිටුවට</a>
    </div>
  </div>
</dialog>

<script>
  import '../scripts/reader.ts';
</script>
