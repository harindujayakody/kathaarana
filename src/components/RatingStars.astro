---
import Icon from './Icon.astro';

interface Props {
  novelId: string;
}

const { novelId } = Astro.props;
---

<div data-rate={novelId} class="flex flex-wrap items-center gap-x-3 gap-y-1">
  <div class="-ml-1.5 flex" role="group" aria-label="තරු ඇගයීම">
    {[1, 2, 3, 4, 5].map((n) => (
      <button type="button" data-star={n} aria-pressed="false" aria-label={`තරු ${n}`} class="tap cursor-pointer p-1.5">
        <Icon name="star" class="h-8 w-8" />
      </button>
    ))}
  </div>
  <span data-rate-msg class="text-sm text-[var(--reader-muted)]" aria-live="polite">ඔබේ ඇගයීම දෙන්න</span>
</div>
