---
import type { CollectionEntry } from 'astro:content';
import BookCard from './BookCard.astro';

interface Props {
  books: CollectionEntry<'books'>[];
  /** Below the fold: every cover loads lazily. */
  lazy?: boolean;
  /** Column classes, replacing the shop's 2 / 3 / 4 / 5. */
  columns?: string;
}

const { books, lazy = false, columns = 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-5' } = Astro.props;
---

<!-- 2 columns on phones, 3 on tablets, 4 on laptops, 5 on wide screens. -->
<div class={`grid gap-3 sm:gap-5 ${columns}`}>
  {books.map((book, i) => (
    <BookCard
      id={book.id}
      title={book.data.title}
      author={book.data.author}
      publisher={book.data.publisher}
      coverImage={book.data.coverImage}
      price={book.data.price}
      eager={!lazy && i < 5}
    />
  ))}
</div>
