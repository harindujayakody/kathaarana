---
import type { CollectionEntry } from 'astro:content';
import BookCard from './BookCard.astro';

interface Props {
  books: CollectionEntry<'books'>[];
}

const { books } = Astro.props;
---

<!-- 2 columns on phones, 3 on tablets, 4 on laptops, 5 on wide screens. -->
<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4 2xl:grid-cols-5">
  {books.map((book, i) => (
    <BookCard
      id={book.id}
      title={book.data.title}
      author={book.data.author}
      publisher={book.data.publisher}
      coverImage={book.data.coverImage}
      price={book.data.price}
      eager={i < 5}
    />
  ))}
</div>
