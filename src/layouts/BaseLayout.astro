---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Icon from '../components/Icon.astro';
import SearchDialog from '../components/SearchDialog.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'book';
  canonicalUrl?: string;
  publishDate?: Date;
  novel?: {
    title: string;
    author: string;
    coverImage: string;
    synopsis?: string;
    url?: string;
    genres?: string[];
    rating?: { value: number; count: number };
  };
  chapter?: {
    number: number;
    title: string;
    wordCount?: number;
  };
  noindex?: boolean;
  /** Chapter pages: the reader bar replaces the bottom tabs. */
  reading?: boolean;
  /** Extra JSON-LD for this page (lists, breadcrumbs). */
  jsonLd?: object[];
}

const {
  title,
  description = 'Katha Arana (කතා අරණ) - ශ්‍රී ලාංකේය ලේඛකයන්ගේ සිංහල නවකතා, අබිරහස් සහ ත්‍රාසජනක කතා නොමිලේ කියවන්න.',
  image,
  type = 'website',
  canonicalUrl,
  publishDate,
  novel,
  chapter,
  noindex = false,
  reading = false,
  jsonLd = [],
} = Astro.props;

const currentPath = Astro.url.pathname;
const tabs = [
  { href: '/', label: 'මුල් පිටුව', short: 'මුල', icon: 'home' },
  { href: '/novels/', label: 'නවකතා', short: 'නවකතා', icon: 'book' },
  { href: '/books/', label: 'පොත් සාප්පුව', short: 'පොත්', icon: 'store' },
  { href: '/genres/', label: 'ප්‍රභේද', short: 'ප්‍රභේද', icon: 'tag' },
  { href: '/authors/', label: 'කතුවරුන්', short: 'කතුවරු', icon: 'users' },
  { href: '/bookmarks/', label: 'මගේ පුස්තකාලය', short: 'පුස්තකාලය', icon: 'bookmark' },
] as const;
// Phones have room for five tabs; genres stay in the desktop sidebar and on novel pages.
const mobileTabs = tabs.filter((tab) => tab.href !== '/genres/');
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));

// Inner pages get a back arrow to their parent, like a native navigation stack.
const segments = currentPath.split('/').filter(Boolean);
const parentPath = segments.length > 1 ? `/${segments.slice(0, -1).join('/')}/` : null;
---

<!doctype html>
<html lang="si">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <Font cssVariable="--font-si-sans" preload={[{ subset: 'sinhala', weight: '400 700' }]} />
    <Font cssVariable="--font-si-serif" />

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      canonicalUrl={canonicalUrl}
      publishDate={publishDate}
      novel={novel}
      chapter={chapter}
      noindex={noindex}
      jsonLd={jsonLd}
    />

    <ClientRouter />

    <!-- Theme before first paint, and again after each in-app navigation swaps <html>.
         Light unless the reader picked another theme; scripts/app.ts setTheme() saves choices. -->
    <meta name="color-scheme" content="light" />
    <script is:inline>
      (function () {
        function apply() {
          var saved = null;
          try {
            saved = localStorage.getItem('katha_theme');
          } catch (e) {}
          if (saved === 'amoled') saved = 'dark';
          var theme = saved || 'light';
          document.documentElement.dataset.theme = theme;
          var meta = document.querySelector('meta[name="color-scheme"]');
          if (meta) meta.content = theme === 'dark' ? 'dark' : 'light';
          try {
            var size = parseFloat(localStorage.getItem('katha_font_size')) || 17;
            document.documentElement.style.setProperty('--reader-font-size', size + 'px');
          } catch (e) {}
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
        // A choice made in another tab.
        addEventListener('storage', function (e) {
          if (e.key === 'katha_theme') apply();
        });
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-[var(--reader-panel)] focus:px-3 focus:py-2">
      අන්තර්ගතයට යන්න
    </a>

    <!-- Desktop sidebar -->
    <aside class="fixed inset-y-0 left-0 z-30 hidden w-64 flex-col border-r border-[var(--reader-border)] bg-[var(--reader-panel)] lg:flex">
      <a href="/" class="flex h-16 shrink-0 items-center px-5" aria-label="කතා අරණ - මුල් පිටුව">
        <span class="brand-logo h-11" aria-hidden="true"></span>
      </a>

      <!-- Opens the site search (also Ctrl/⌘+K or "/"). -->
      <button
        type="button"
        data-search-open
        class="tap mx-3 mb-3 flex cursor-pointer items-center gap-2 rounded-lg border border-[var(--reader-border)] bg-[var(--reader-bg)] px-3 py-2 text-left text-sm text-[var(--reader-muted)] hover:text-[var(--reader-text)]"
      >
        <Icon name="search" class="h-4 w-4" />
        <span class="flex-1">සොයන්න…</span>
        <kbd class="rounded border border-[var(--reader-border)] px-1.5 font-sans text-xs">Ctrl K</kbd>
      </button>

      <nav class="px-3" aria-label="ප්‍රධාන සංචලනය">
        {tabs.map((tab) => (
          <a
            href={tab.href}
            aria-current={isActive(tab.href) ? 'page' : undefined}
            class={`tap mb-0.5 flex items-center gap-3 rounded-lg px-3 py-2.5 text-[0.9375rem] ${
              isActive(tab.href)
                ? 'bg-[var(--reader-bg)] font-semibold text-[var(--reader-text)]'
                : 'text-[var(--reader-muted)] hover:bg-[var(--reader-bg)] hover:text-[var(--reader-text)]'
            }`}
          >
            <Icon name={tab.icon} />
            <span class="flex-1">{tab.label}</span>
            {tab.icon === 'bookmark' && (
              <span data-library-badge hidden class="accent-badge rounded-full px-2 py-0.5 text-xs font-semibold tabular-nums" />
            )}
          </a>
        ))}
      </nav>

      <section data-continue="4" hidden class="mt-5 min-h-0 flex-1 overflow-y-auto border-t border-[var(--reader-border)] px-3 pt-4">
        <h2 class="px-2 pb-2 font-sans text-sm font-semibold text-[var(--reader-muted)]">දිගටම කියවන්න</h2>
        <div data-continue-list></div>
      </section>

      <div class="mt-auto flex items-center gap-1 border-t border-[var(--reader-border)] p-3">
        <button
          type="button"
          data-theme-toggle
          class="tap flex flex-1 cursor-pointer items-center gap-3 rounded-lg px-3 py-2.5 text-[0.9375rem] text-[var(--reader-muted)] hover:bg-[var(--reader-bg)] hover:text-[var(--reader-text)]"
        >
          <Icon name="moon" class="h-5 w-5 dark:hidden" />
          <Icon name="sun" class="hidden h-5 w-5 dark:block" />
          <span class="dark:hidden">අඳුරු තේමාව</span>
          <span class="hidden dark:inline">ආලෝක තේමාව</span>
        </button>
        <a
          href="/rss.xml"
          data-astro-reload
          class="tap rounded-lg p-2.5 text-[var(--reader-muted)] hover:bg-[var(--reader-bg)] hover:text-[var(--reader-text)]"
          aria-label="RSS පෝෂණය"
          title="RSS"
        >
          <Icon name="rss" />
        </a>
      </div>
    </aside>

    <div class="flex min-h-dvh flex-col lg:pl-64">
      <!-- Phone and tablet top bar -->
      <header id="mobile-header" class="sticky top-0 z-30 flex h-14 items-center gap-1 border-b border-[var(--reader-border)] bg-[var(--reader-panel)] px-2 lg:hidden">
        {parentPath ? (
          <a href={parentPath} class="tap rounded-lg p-2.5 text-[var(--reader-text)]" aria-label="ආපසු">
            <Icon name="left" />
          </a>
        ) : (
          <span class="w-1.5" aria-hidden="true"></span>
        )}
        <a href="/" class="px-1.5" aria-label="කතා අරණ - මුල් පිටුව">
          <span class="brand-logo h-9" aria-hidden="true"></span>
        </a>
        <button type="button" data-search-open class="tap ml-auto cursor-pointer rounded-lg p-2.5 text-[var(--reader-muted)]" aria-label="සොයන්න">
          <Icon name="search" class="h-5 w-5" />
        </button>
        <button
          type="button"
          data-theme-toggle
          class="tap cursor-pointer rounded-lg p-2.5 text-[var(--reader-muted)]"
          aria-label="අඳුරු / ආලෝක තේමාව මාරු කරන්න"
        >
          <Icon name="moon" class="h-5 w-5 dark:hidden" />
          <Icon name="sun" class="hidden h-5 w-5 dark:block" />
        </button>
      </header>

      <main id="main" class="flex-1">
        <slot />
      </main>

      <footer class={`px-4 pt-10 text-xs text-[var(--reader-muted)] sm:px-6 lg:px-8 lg:pb-8 ${reading ? 'pb-24' : 'pb-[calc(5.5rem+env(safe-area-inset-bottom))]'}`}>
        <!-- Phones: one centered column with the logo. Wider: copyright left, credit right. -->
        <div class="mx-auto flex max-w-[90rem] flex-col items-center gap-2 border-t border-[var(--reader-border)] pt-6 text-center sm:flex-row sm:justify-between sm:gap-1 sm:pt-5 sm:text-left">
          <a href="/" class="mb-1 sm:hidden" aria-label="කතා අරණ"><span class="brand-logo h-8 opacity-90" aria-hidden="true"></span></a>
          <span class="leading-relaxed">© {new Date().getFullYear()} කතා අරණ (Katha Arana). All Rights reserved!</span>
          <span class="inline-flex items-center gap-1">
            Made with
            <svg class="heartbeat h-3.5 w-3.5 text-[var(--like)]" viewBox="0 0 24 24" fill="currentColor" role="img" aria-label="love">
              <path d="M12 20s-7.5-4.4-7.5-10A4.3 4.3 0 0 1 12 7.2 4.3 4.3 0 0 1 19.5 10c0 5.6-7.5 10-7.5 10z" />
            </svg>
            by
            <a href="https://infiax.com" target="_blank" rel="noopener noreferrer" class="font-medium text-[var(--reader-text)] underline-offset-2 hover:underline">Infiax 360</a>
          </span>
        </div>
      </footer>
    </div>

    <!-- Phone and tablet bottom tabs -->
    {!reading && (
      <nav
        class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-5 border-t border-[var(--reader-border)] bg-[var(--reader-panel)] pb-[env(safe-area-inset-bottom)] lg:hidden"
        aria-label="ප්‍රධාන සංචලනය"
      >
        {mobileTabs.map((tab) => (
          <a
            href={tab.href}
            aria-current={isActive(tab.href) ? 'page' : undefined}
            class={`tap relative flex min-w-0 flex-col items-center gap-0.5 px-1 pb-1.5 pt-2 text-[0.6875rem] ${
              isActive(tab.href) ? 'accent-text font-semibold' : 'text-[var(--reader-muted)]'
            }`}
          >
            <Icon name={tab.icon} class="h-[22px] w-[22px]" />
            <span class="max-w-full truncate">{tab.short}</span>
            {tab.icon === 'bookmark' && (
              <span data-library-badge hidden class="accent-bg absolute right-[22%] top-1 min-w-4 rounded-full px-1 text-center text-[0.625rem] font-semibold leading-4 tabular-nums" />
            )}
          </a>
        ))}
      </nav>
    )}

    <SearchDialog />

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
