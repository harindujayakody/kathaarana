---
import { Font } from 'astro:assets';
import SEO from '../components/SEO.astro';
import BookmarksDrawer from '../components/BookmarksDrawer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'book';
  canonicalUrl?: string;
  publishDate?: Date;
  novel?: {
    title: string;
    author: string;
    coverImage: string;
    synopsis?: string;
    url?: string;
    genres?: string[];
  };
  chapter?: {
    number: number;
    title: string;
    wordCount?: number;
  };
  hideHeader?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = 'Katha Arana (කතා අරණ) - ශ්‍රී ලාංකේය ලේඛකයන්ගේ සිංහල නවකතා, අබිරහස් සහ ත්‍රාසජනක කතා නොමිලේ කියවන්න.',
  image,
  type = 'website',
  canonicalUrl,
  publishDate,
  novel,
  chapter,
  hideHeader = false,
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const navLinks = [
  { href: '/novels/', label: 'නවකතා' },
  { href: '/genres/', label: 'ප්‍රභේද' },
  { href: '/authors/', label: 'කතුවරුන්' },
];
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<!doctype html>
<html lang="si" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <Font cssVariable="--font-si-sans" preload={[{ subset: 'sinhala', weight: '400 700' }]} />
    <Font cssVariable="--font-si-serif" />

    <!-- SEO & OpenGraph Engine -->
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      canonicalUrl={canonicalUrl}
      publishDate={publishDate}
      novel={novel}
      chapter={chapter}
      noindex={noindex}
    />

    <!-- Anti-FOUC Theme Initializer -->
    <script is:inline>
      (function() {
        try {
          const savedTheme = localStorage.getItem('katha_theme') || 'light';
          document.documentElement.setAttribute('data-theme', savedTheme);
          const savedSize = localStorage.getItem('katha_font_size');
          if (savedSize) {
            const sizeVal = savedSize.includes('rem') || savedSize.includes('px') ? savedSize : (parseFloat(savedSize) > 5 ? `${savedSize}px` : `${savedSize}rem`);
            document.documentElement.style.setProperty('--reader-font-size', sizeVal);
          } else {
            document.documentElement.style.setProperty('--reader-font-size', '17px');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col selection:bg-[#0F766E]/20 selection:text-[#0F766E] dark:selection:bg-[#2DD4BF]/20 dark:selection:text-[#2DD4BF]">
    
    {!hideHeader && (
      <header class="sticky top-0 z-40 border-b border-[var(--reader-border)] bg-[var(--reader-bg)] transition-colors">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center gap-8">
          <a href="/" class="font-serif font-bold text-xl shrink-0 hover:accent-text transition-colors">කතා අරණ</a>

          <nav class="hidden md:flex items-center gap-6 text-[0.9375rem]" aria-label="ප්‍රධාන සංචලනය">
            {navLinks.map(link => (
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class={isActive(link.href) ? 'font-semibold text-[var(--reader-text)]' : 'text-[var(--reader-muted)] hover:text-[var(--reader-text)] transition-colors'}
              >
                {link.label}
              </a>
            ))}
          </nav>

          <div class="ml-auto flex items-center gap-1">
            <a
              href="/bookmarks/"
              class="relative p-2 rounded-md text-[var(--reader-muted)] hover:text-[var(--reader-text)] transition-colors"
              aria-label="පිටුසන් සහ කියවීම් ඉතිහාසය"
              title="පිටුසන්"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 4h12v16l-6-4-6 4V4z" />
              </svg>
              <span
                id="nav-bookmark-badge"
                class="hidden absolute top-0.5 right-0.5 min-w-[16px] h-4 px-1 rounded-full accent-bg text-[10px] font-semibold items-center justify-center leading-none"
              >0</span>
            </a>

            <button
              id="global-theme-toggle"
              type="button"
              class="p-2 rounded-md text-[var(--reader-muted)] hover:text-[var(--reader-text)] transition-colors cursor-pointer"
              aria-label="අඳුරු / ආලෝක තේමාව මාරු කරන්න"
              title="තේමාව"
            >
              <svg id="theme-sun-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path stroke-linecap="round" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
              </svg>
              <svg id="theme-moon-icon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
              </svg>
            </button>

            <button
              id="btn-mobile-menu"
              type="button"
              class="md:hidden p-2 rounded-md text-[var(--reader-muted)] hover:text-[var(--reader-text)] transition-colors"
              aria-label="මෙනුව විවෘත කරන්න"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
              </svg>
            </button>
          </div>
        </div>
      </header>
    )}

    <main class="flex-1">
      <slot />
    </main>

    <!-- Mobile menu (kept at body root to avoid stacking-context bugs) -->
    <div
      id="mobile-menu-drawer"
      inert
      class="md:hidden fixed inset-0 bg-black/50 z-50 opacity-0 pointer-events-none transition-opacity duration-200"
      aria-hidden="true"
    >
      <div
        id="mobile-menu-panel"
        class="fixed right-0 top-0 bottom-0 w-72 max-w-[85vw] bg-[var(--reader-bg)] border-l border-[var(--reader-border)] px-6 py-4 flex flex-col translate-x-full transition-transform duration-300 ease-out text-[var(--reader-text)] overflow-y-auto"
      >
        <div class="h-10 flex items-center justify-between">
          <span class="font-serif font-bold text-lg">කතා අරණ</span>
          <button
            id="btn-close-mobile-menu"
            type="button"
            class="p-2 -mr-2 rounded-md text-[var(--reader-muted)] hover:text-[var(--reader-text)] transition-colors cursor-pointer"
            aria-label="වසන්න"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </div>

        <nav class="mt-4 flex flex-col text-lg" aria-label="ප්‍රධාන සංචලනය">
          {[{ href: '/', label: 'මුල් පිටුව' }, ...navLinks, { href: '/bookmarks/', label: 'පිටුසන්' }].map(link => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class={`py-3 border-b border-[var(--reader-border)] ${isActive(link.href) ? 'font-semibold' : ''}`}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </div>

    <!-- Global Bookmarks Drawer Modal -->
    <BookmarksDrawer />

    <footer class="mt-20 border-t border-[var(--reader-border)] transition-colors">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6">
        <div>
          <a href="/" class="font-serif font-bold text-lg">කතා අරණ</a>
          <p class="mt-1 text-sm text-[var(--reader-muted)] max-w-xs leading-relaxed">සිංහල නවකතා, පරිච්ඡේදයෙන් පරිච්ඡේදය. නොමිලේ, ගිණුමක් නැතිව.</p>
        </div>
        <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-[var(--reader-muted)]" aria-label="පාදක සංචලනය">
          {[...navLinks, { href: '/bookmarks/', label: 'පිටුසන්' }, { href: '/rss.xml', label: 'RSS' }].map(link => (
            <a href={link.href} class="hover:text-[var(--reader-text)] transition-colors">{link.label}</a>
          ))}
        </nav>
      </div>
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-5 border-t border-[var(--reader-border)] flex flex-col sm:flex-row sm:justify-between gap-1 text-xs text-[var(--reader-muted)]">
        <span>© {new Date().getFullYear()} කතා අරණ (Katha Arana)</span>
        <span>Developed by <a href="https://infiax.com" target="_blank" rel="noopener noreferrer" class="font-medium text-[var(--reader-text)] hover:underline underline-offset-2">Infiax 360</a></span>
      </div>
    </footer>

    <!-- Global Theme Toggle & Mobile Menu Script -->
    <script>
      const syncThemeIcons = () => {
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
        const isDark = currentTheme === 'dark' || currentTheme === 'amoled';
        const sun = document.getElementById('theme-sun-icon');
        const moon = document.getElementById('theme-moon-icon');
        const label = document.getElementById('theme-label');

        if (sun && moon) {
          if (isDark) {
            sun.classList.remove('hidden');
            moon.classList.add('hidden');
            if (label) label.textContent = 'අඳුරු';
          } else {
            sun.classList.add('hidden');
            moon.classList.remove('hidden');
            if (label) label.textContent = 'ආලෝකය';
          }
        }
      };

      const toggleGlobalTheme = () => {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const next = (current === 'light' || current === 'sepia') ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('katha_theme', next);
        syncThemeIcons();
        window.dispatchEvent(new CustomEvent('katha-theme-changed', { detail: next }));
      };

      document.getElementById('global-theme-toggle')?.addEventListener('click', toggleGlobalTheme);
      window.addEventListener('katha-theme-changed', syncThemeIcons);
      syncThemeIcons();

      // Mobile Menu Drawer Handlers
      const mobileDrawer = document.getElementById('mobile-menu-drawer');
      const mobilePanel = document.getElementById('mobile-menu-panel');
      const openMobileBtn = document.getElementById('btn-mobile-menu');
      const closeMobileBtn = document.getElementById('btn-close-mobile-menu');

      // Closed drawers are inert so hidden links can't take keyboard focus.
      const openMobileMenu = () => {
        mobileDrawer?.removeAttribute('inert');
        mobileDrawer?.setAttribute('aria-hidden', 'false');
        mobileDrawer?.classList.remove('opacity-0', 'pointer-events-none');
        mobileDrawer?.classList.add('opacity-100');
        mobilePanel?.classList.remove('translate-x-full');
        mobilePanel?.classList.add('translate-x-0');
        closeMobileBtn?.focus();
      };

      const closeMobileMenu = () => {
        if (mobileDrawer?.hasAttribute('inert')) return;
        mobileDrawer?.setAttribute('inert', '');
        mobileDrawer?.setAttribute('aria-hidden', 'true');
        mobileDrawer?.classList.add('opacity-0', 'pointer-events-none');
        mobileDrawer?.classList.remove('opacity-100');
        mobilePanel?.classList.add('translate-x-full');
        mobilePanel?.classList.remove('translate-x-0');
        openMobileBtn?.focus();
      };
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMobileMenu();
      });

      openMobileBtn?.addEventListener('click', openMobileMenu);
      closeMobileBtn?.addEventListener('click', closeMobileMenu);
      mobileDrawer?.addEventListener('click', (e) => {
        if (e.target === mobileDrawer) closeMobileMenu();
      });
    </script>
  </body>
</html>
