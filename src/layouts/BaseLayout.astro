---
import SEO from '../components/SEO.astro';
import BookmarksDrawer from '../components/BookmarksDrawer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'book';
  canonicalUrl?: string;
  publishDate?: Date;
  novel?: {
    title: string;
    author: string;
    coverImage: string;
    synopsis?: string;
    url?: string;
  };
  chapter?: {
    number: number;
    title: string;
    wordCount?: number;
  };
  hideHeader?: boolean;
}

const {
  title,
  description = 'Katha Arana (කතා අරණ) - ශ්‍රී ලාංකේය ලේඛකයන්ගේ සිංහල නවකතා, අබිරහස් සහ ත්‍රාසජනක කතා නොමිලේ කියවන්න.',
  image,
  type = 'website',
  canonicalUrl,
  publishDate,
  novel,
  chapter,
  hideHeader = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="si" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Noto Sans Sinhala & Noto Serif Sinhala -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Sinhala:wght@300;400;500;600;700&family=Noto+Serif+Sinhala:wght@400;600;700;800&family=Lora:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- SEO & OpenGraph Engine -->
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      canonicalUrl={canonicalUrl}
      publishDate={publishDate}
      novel={novel}
      chapter={chapter}
    />

    <!-- Anti-FOUC Theme Initializer -->
    <script is:inline>
      (function() {
        try {
          const savedTheme = localStorage.getItem('katha_theme') || 'light';
          document.documentElement.setAttribute('data-theme', savedTheme);
          const savedSize = localStorage.getItem('katha_font_size');
          if (savedSize) {
            const sizeVal = savedSize.includes('rem') || savedSize.includes('px') ? savedSize : (parseFloat(savedSize) > 5 ? `${savedSize}px` : `${savedSize}rem`);
            document.documentElement.style.setProperty('--reader-font-size', sizeVal);
          } else {
            document.documentElement.style.setProperty('--reader-font-size', '17px');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col selection:bg-[#0F766E]/20 selection:text-[#0F766E] dark:selection:bg-[#2DD4BF]/20 dark:selection:text-[#2DD4BF]">
    
    {!hideHeader && (
      <header class="border-b border-[var(--reader-border)] bg-[var(--reader-panel)]/95 backdrop-blur-md sticky top-0 z-40 transition-colors">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
          
          <!-- Logo & Brand -->
          <a href="/" class="flex items-center gap-2.5 group shrink-0">
            <span class="w-9 h-9 rounded-xl accent-bg flex items-center justify-center font-bold text-base shadow-sm group-hover:scale-105 transition-transform">
              ක
            </span>
            <div class="flex flex-col">
              <span class="font-bold text-lg tracking-tight leading-tight group-hover:accent-text transition-colors font-serif">
                Katha Arana
              </span>
              <span class="text-[10px] text-[var(--reader-muted)] -mt-0.5 tracking-wider font-medium">
                කතා අරණ • Realm of Novels
              </span>
            </div>
          </a>

          <!-- Desktop Navigation -->
          <nav class="hidden md:flex items-center gap-1.5 lg:gap-2 text-xs font-medium">
            <a
              href="/"
              class={`px-3 py-2 rounded-xl transition-all ${currentPath === '/' ? 'accent-badge font-semibold' : 'text-[var(--reader-muted)] hover:text-[var(--reader-text)] hover:bg-[var(--reader-border)]/40'}`}
            >
              මුල් පිටුව
            </a>
            <a
              href="/novels"
              class={`px-3 py-2 rounded-xl transition-all ${currentPath.startsWith('/novels') && !currentPath.includes('/novels/') ? 'accent-badge font-semibold' : 'text-[var(--reader-muted)] hover:text-[var(--reader-text)] hover:bg-[var(--reader-border)]/40'}`}
            >
              සියලුම නවකතා
            </a>
            <a
              href="/authors"
              class={`px-3 py-2 rounded-xl transition-all ${currentPath.startsWith('/authors') ? 'accent-badge font-semibold' : 'text-[var(--reader-muted)] hover:text-[var(--reader-text)] hover:bg-[var(--reader-border)]/40'}`}
            >
              කතුවරුන්
            </a>
            <a
              href="/genres"
              class={`px-3 py-2 rounded-xl transition-all ${currentPath.startsWith('/genres') ? 'accent-badge font-semibold' : 'text-[var(--reader-muted)] hover:text-[var(--reader-text)] hover:bg-[var(--reader-border)]/40'}`}
            >
              වර්ගීකරණය
            </a>
          </nav>

          <!-- Right Action Items (Bookmarks, RSS, Theme Toggle, Mobile Menu) -->
          <div class="flex items-center gap-2 sm:gap-2.5">
            
            <!-- Bookmarks Desk Shortcut Link -->
            <a
              href="/bookmarks"
              class={`relative px-2.5 sm:px-3 py-2 rounded-xl border border-[var(--reader-border)] hover:bg-[var(--reader-border)]/50 active:scale-95 transition-all text-[var(--reader-text)] flex items-center gap-1.5 cursor-pointer text-xs font-medium ${currentPath === '/bookmarks' ? 'accent-badge font-semibold' : ''}`}
              title="මගේ කියවීම් ලැයිස්තුව සහ පිටුසන්"
            >
              <svg class="w-4 h-4 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17 3H7c-1.1 0-2 .9-2 2v16l7-3 7 3V5c0-1.1-.9-2-2-2z"/>
              </svg>
              <span class="hidden sm:inline">පිටුසන්</span>
              <span
                id="nav-bookmark-badge"
                class="hidden min-w-[18px] h-[18px] px-1 rounded-full accent-bg text-[10px] font-bold items-center justify-center leading-none shadow-xs text-white"
              >
                0
              </span>
            </a>

            <!-- RSS Feed -->
            <a
              href="/rss.xml"
              class="p-2 sm:px-2.5 sm:py-2 rounded-xl border border-[var(--reader-border)] hover:bg-[var(--reader-border)]/40 text-amber-600 dark:text-amber-400 active:scale-95 transition-all flex items-center gap-1"
              title="Subscribe via RSS"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93v-2.83Z"/>
              </svg>
              <span class="hidden lg:inline text-xs font-medium">RSS</span>
            </a>

            <!-- Mobile & Desktop Responsive Light / Dark Mode Toggle -->
            <button
              id="global-theme-toggle"
              type="button"
              class="p-2 sm:px-3 sm:py-2 rounded-xl border border-[var(--reader-border)] hover:bg-[var(--reader-border)]/50 active:scale-95 transition-all text-[var(--reader-text)] flex items-center gap-1.5 cursor-pointer"
              aria-label="තේමාව මාරු කරන්න (Light / Dark mode)"
              title="තේමාව මාරු කරන්න"
            >
              <!-- Sun Icon (Active in Dark/AMOLED) -->
              <svg id="theme-sun-icon" class="w-4 h-4 hidden text-[#2DD4BF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              <!-- Moon Icon (Active in Light/Sepia) -->
              <svg id="theme-moon-icon" class="w-4 h-4 text-[#0F766E]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
              <span id="theme-label" class="text-xs font-medium text-[var(--reader-muted)] hidden md:inline">තේමාව</span>
            </button>

            <!-- Mobile Hamburger Button -->
            <button
              id="btn-mobile-menu"
              type="button"
              class="md:hidden p-2 rounded-xl border border-[var(--reader-border)] hover:bg-[var(--reader-border)]/50 text-[var(--reader-text)] active:scale-95 transition-all"
              aria-label="මෙනුව විවෘත කරන්න"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>

          </div>
        </div>
      </header>
    )}

    <main class="flex-1">
      <slot />
    </main>

    <!-- Mobile Drawer Navigation (At root to prevent stacking context bugs) -->
    <div
      id="mobile-menu-drawer"
      class="md:hidden fixed inset-0 bg-black/75 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300"
      aria-hidden="true"
    >
      <div
        id="mobile-menu-panel"
        class="fixed right-0 top-0 bottom-0 w-80 max-w-[85vw] h-full bg-[var(--reader-panel)] border-l border-[var(--reader-border)] p-6 shadow-2xl flex flex-col translate-x-full transition-transform duration-300 ease-out z-50 text-[var(--reader-text)] overflow-y-auto"
      >
        <div class="flex items-center justify-between pb-4 border-b border-[var(--reader-border)]">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-xl accent-bg flex items-center justify-center font-bold text-sm text-white shadow-xs">
              ක
            </span>
            <div>
              <span class="font-bold text-base font-serif text-[var(--reader-text)] block leading-tight">සංචලනය</span>
              <span class="text-[10px] text-[var(--reader-muted)]">Katha Arana Menu</span>
            </div>
          </div>
          <button
            id="btn-close-mobile-menu"
            type="button"
            class="p-2 rounded-xl hover:bg-[var(--reader-border)]/50 text-[var(--reader-muted)] hover:text-[var(--reader-text)] transition-colors cursor-pointer"
            aria-label="වසන්න"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <nav class="flex flex-col gap-1.5 py-6 text-sm font-medium">
          <a href="/" class="px-3.5 py-2.5 rounded-xl hover:bg-[var(--reader-border)]/40 text-[var(--reader-text)] transition-colors flex items-center justify-between">
            <span>මුල් පිටුව</span>
            <span class="text-xs text-[var(--reader-muted)] font-normal">Home</span>
          </a>
          <a href="/novels" class="px-3.5 py-2.5 rounded-xl hover:bg-[var(--reader-border)]/40 text-[var(--reader-text)] transition-colors flex items-center justify-between">
            <span>සියලුම නවකතා</span>
            <span class="text-xs text-[var(--reader-muted)] font-normal">All Novels</span>
          </a>
          <a href="/authors" class="px-3.5 py-2.5 rounded-xl hover:bg-[var(--reader-border)]/40 text-[var(--reader-text)] transition-colors flex items-center justify-between">
            <span>කතුවරුන්ගේ නාමාවලිය</span>
            <span class="text-xs text-[var(--reader-muted)] font-normal">Authors</span>
          </a>
          <a href="/genres" class="px-3.5 py-2.5 rounded-xl hover:bg-[var(--reader-border)]/40 text-[var(--reader-text)] transition-colors flex items-center justify-between">
            <span>නවකතා වර්ගීකරණය</span>
            <span class="text-xs text-[var(--reader-muted)] font-normal">Genres</span>
          </a>
          <a href="/bookmarks" class="px-3.5 py-2.5 rounded-xl accent-badge flex items-center justify-between mt-3 font-semibold">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
              </svg>
              <span>මගේ කියවීම් ලැයිස්තුව</span>
            </span>
            <span class="text-xs">බලන්න →</span>
          </a>
        </nav>

        <div class="mt-auto pt-4 border-t border-[var(--reader-border)] text-xs text-[var(--reader-muted)] space-y-1">
          <p class="font-semibold text-[var(--reader-text)]">Katha Arana (කතා අරණ)</p>
          <p>නොමිලේ සිංහල වෙබ් නවකතා කියවීමේ නිදහස් අවකාශය</p>
        </div>
      </div>
    </div>

    <!-- Global Bookmarks Drawer Modal -->
    <BookmarksDrawer />

    <!-- Redesigned High-Craft Footer -->
    <footer class="border-t border-[var(--reader-border)] bg-[var(--reader-panel)] mt-24 pt-16 pb-12 transition-colors">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        
        <!-- Main Footer Columns -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-[var(--reader-border)]">
          
          <!-- Col 1: About Platform -->
          <div class="space-y-4 sm:col-span-2 lg:col-span-1">
            <div class="flex items-center gap-2.5">
              <span class="w-8 h-8 rounded-xl accent-bg flex items-center justify-center font-bold text-sm shadow-xs">
                ක
              </span>
              <span class="font-bold text-base font-serif text-[var(--reader-text)]">
                Katha Arana (කතා අරණ)
              </span>
            </div>
            <p class="text-xs text-[var(--reader-muted)] leading-relaxed">
              ශ්‍රී ලාංකේය ලේඛකයන්ගේ සිංහල වෙබ් නවකතා, අබිරහස් සහ ත්‍රාසජනක කතා කියවීමට නිර්මාණය කළ නිදහස් ඩිජිටල් අවකාශය. ජංගම දුරකථන සඳහා විශේෂිතව සකස් කරන ලද 17px අකුරු මෝස්තරය.
            </p>
            <div class="flex items-center gap-2 text-xs">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-medium accent-badge border border-[var(--theme-accent)]/20">
                <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                Cloudflare Edge SSG
              </span>
              <span class="px-2.5 py-1 rounded-md text-[10px] font-medium bg-[var(--reader-border)]/50 text-[var(--reader-muted)]">
                100% නොමිලේ
              </span>
            </div>
          </div>

          <!-- Col 2: Navigation Links -->
          <div class="space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--reader-text)] font-serif">
              ප්‍රධාන සංචලනය
            </h3>
            <ul class="space-y-2 text-xs text-[var(--reader-muted)]">
              <li><a href="/" class="hover:accent-text transition-colors">මුල් පිටුව (Home)</a></li>
              <li><a href="/novels" class="hover:accent-text transition-colors">සියලුම නවකතා (All Novels)</a></li>
              <li><a href="/authors" class="hover:accent-text transition-colors">කතුවරුන්ගේ නාමාවලිය (Authors)</a></li>
              <li><a href="/genres" class="hover:accent-text transition-colors">වර්ගීකරණය (Genres)</a></li>
              <li><button data-trigger-bookmarks class="hover:accent-text transition-colors text-left">මගේ කියවීම් මේසය (My Desk)</button></li>
            </ul>
          </div>

          <!-- Col 3: Popular Genres -->
          <div class="space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--reader-text)] font-serif">
              ජනප්‍රිය වර්ගීකරණ
            </h3>
            <ul class="space-y-2 text-xs text-[var(--reader-muted)]">
              <li><a href="/genres/crime" class="hover:accent-text transition-colors">අපරාධ පරීක්ෂණ</a></li>
              <li><a href="/genres/thriller" class="hover:accent-text transition-colors">ත්‍රාසජනක</a></li>
              <li><a href="/genres/mystery" class="hover:accent-text transition-colors">අබිරහස්</a></li>
              <li><a href="/genres/romance" class="hover:accent-text transition-colors">ආදර කතා</a></li>
              <li><a href="/genres/fantasy" class="hover:accent-text transition-colors">ෆැන්ටසි</a></li>
            </ul>
          </div>

          <!-- Col 4: Reader Perks -->
          <div class="space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--reader-text)] font-serif">
              පාඨක පහසුකම්
            </h3>
            <ul class="space-y-2.5 text-xs text-[var(--reader-muted)]">
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full accent-bg shrink-0"></span><span>තේමා 4ක් (Light, Sepia, Dark, AMOLED)</span></li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full accent-bg shrink-0"></span><span>ජංගම දුරකථන Floating Controls</span></li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full accent-bg shrink-0"></span><span>ස්වයංක්‍රීය LocalStorage පිටුසන්</span></li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full accent-bg shrink-0"></span><a href="/rss.xml" class="hover:underline accent-text font-medium">RSS Feed මගින් යාවත්කාලීන වීම්</a></li>
            </ul>
          </div>

        </div>

        <!-- Bottom Copyright & Infiax 360 Credits -->
        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--reader-muted)]">
          <div class="flex items-center gap-2">
            <span>© 2026 Katha Arana (කතා අරණ). All Rights Reserved.</span>
          </div>

          <!-- Developed by Infiax 360 -->
          <div class="flex items-center gap-1.5 font-medium">
            <span>Developed by</span>
            <a
              href="https://infiax.com"
              target="_blank"
              rel="noopener noreferrer"
              class="font-bold accent-text hover:underline inline-flex items-center gap-1 group py-0.5 px-1.5 rounded-md hover:bg-[var(--reader-border)]/40 transition-all"
            >
              <span>Infiax 360</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>

      </div>
    </footer>

    <!-- Global Theme Toggle & Mobile Menu Script -->
    <script>
      const syncThemeIcons = () => {
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
        const isDark = currentTheme === 'dark' || currentTheme === 'amoled';
        const sun = document.getElementById('theme-sun-icon');
        const moon = document.getElementById('theme-moon-icon');
        const label = document.getElementById('theme-label');

        if (sun && moon) {
          if (isDark) {
            sun.classList.remove('hidden');
            moon.classList.add('hidden');
            if (label) label.textContent = 'අඳුරු';
          } else {
            sun.classList.add('hidden');
            moon.classList.remove('hidden');
            if (label) label.textContent = 'ආලෝකය';
          }
        }
      };

      const toggleGlobalTheme = () => {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const next = (current === 'light' || current === 'sepia') ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('katha_theme', next);
        syncThemeIcons();
        window.dispatchEvent(new CustomEvent('katha-theme-changed', { detail: next }));
      };

      document.getElementById('global-theme-toggle')?.addEventListener('click', toggleGlobalTheme);
      window.addEventListener('katha-theme-changed', syncThemeIcons);
      syncThemeIcons();

      // Mobile Menu Drawer Handlers
      const mobileDrawer = document.getElementById('mobile-menu-drawer');
      const mobilePanel = document.getElementById('mobile-menu-panel');
      const openMobileBtn = document.getElementById('btn-mobile-menu');
      const closeMobileBtn = document.getElementById('btn-close-mobile-menu');

      const openMobileMenu = () => {
        mobileDrawer?.classList.remove('opacity-0', 'pointer-events-none');
        mobileDrawer?.classList.add('opacity-100');
        mobilePanel?.classList.remove('translate-x-full');
        mobilePanel?.classList.add('translate-x-0');
      };

      const closeMobileMenu = () => {
        mobileDrawer?.classList.add('opacity-0', 'pointer-events-none');
        mobileDrawer?.classList.remove('opacity-100');
        mobilePanel?.classList.add('translate-x-full');
        mobilePanel?.classList.remove('translate-x-0');
      };

      openMobileBtn?.addEventListener('click', openMobileMenu);
      closeMobileBtn?.addEventListener('click', closeMobileMenu);
      mobileDrawer?.addEventListener('click', (e) => {
        if (e.target === mobileDrawer) closeMobileMenu();
      });
    </script>
  </body>
</html>
