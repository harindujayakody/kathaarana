---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NovelCard from '../../components/NovelCard.astro';
import { getCollection } from 'astro:content';
import { GENRE_MAP, getGenreSlug } from '../../utils/genres';

const novels = await getCollection('novels');
const allChapters = await getCollection('chapters');

// Sort novels by publishDate descending
const sortedNovels = novels.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

// Chapter counts
const novelChapterCounts: Record<string, number> = {};
allChapters.forEach(c => {
  novelChapterCounts[c.data.novel] = (novelChapterCounts[c.data.novel] || 0) + 1;
});

// All genres
const allGenres = Array.from(new Set(novels.flatMap(n => n.data.genres)));
---

<BaseLayout
  title="සියලුම සිංහල නවකතා - Katha Arana"
  description="කතා අරණ වෙබ් අඩවියේ ඇති සියලුම සිංහල නවකතා, අබිරහස් සහ ත්‍රාසජනක කතා නාමාවලිය. නොමිලේ කියවන්න."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10">
    
    <!-- Page Header & Search Bar -->
    <div class="space-y-4">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[var(--reader-muted)]">
        <a href="/" class="hover:underline">මුල් පිටුව</a>
        <span>/</span>
        <span class="text-[var(--reader-text)] font-semibold">සියලුම නවකතා</span>
      </nav>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[var(--reader-border)]">
        <div class="flex items-center gap-3">
          <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-[var(--reader-text)] font-serif">
            සියලුම සිංහල නවකතා
          </h1>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold accent-badge border border-[var(--theme-accent)]/20">
            {novels.length}
          </span>
        </div>

        <!-- Live Instant Search Bar -->
        <div class="w-full sm:w-72 md:w-80">
          <div class="relative">
            <svg class="w-4 h-4 text-[var(--reader-muted)] absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              id="novel-search-input"
              type="text"
              placeholder="නවකතාවක් හෝ කතුවරයෙකු සොයන්න..."
              class="w-full pl-10 pr-4 py-2.5 rounded-2xl bg-[var(--reader-panel)] border border-[var(--reader-border)] text-xs text-[var(--reader-text)] placeholder-[var(--reader-muted)] focus:outline-none focus:border-[var(--theme-accent)] transition-all shadow-xs"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Sleek Minimalist Controls (No nested card container!) -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3.5 pb-4 border-b border-[var(--reader-border)]">
      
      <!-- Status Segmented Control -->
      <div class="inline-flex p-1 rounded-xl bg-[var(--reader-panel)] border border-[var(--reader-border)] text-xs font-medium self-start">
        <button
          data-filter-status="all"
          class="status-btn px-3 py-1.5 rounded-lg accent-bg font-semibold shadow-xs transition-all cursor-pointer"
        >
          සියලුම ({novels.length})
        </button>
        <button
          data-filter-status="Ongoing"
          class="status-btn px-3 py-1.5 rounded-lg text-[var(--reader-muted)] hover:text-[var(--reader-text)] transition-all cursor-pointer"
        >
          ලියවෙමින් පවතින
        </button>
        <button
          data-filter-status="Completed"
          class="status-btn px-3 py-1.5 rounded-lg text-[var(--reader-muted)] hover:text-[var(--reader-text)] transition-all cursor-pointer"
        >
          සම්පූර්ණ වූ
        </button>
      </div>

      <!-- Quick Genre Carousel -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs scrollbar-none max-w-full">
        <button
          data-filter-genre="all"
          class="genre-btn px-3 py-1.5 rounded-xl accent-badge font-semibold shrink-0 transition-all border border-[var(--theme-accent)]/30 cursor-pointer"
        >
          ✨ සියලු වර්ග
        </button>
        {allGenres.map(g => (
          <button
            data-filter-genre={g}
            class="genre-btn px-3 py-1.5 rounded-xl bg-[var(--reader-panel)] border border-[var(--reader-border)] text-[var(--reader-muted)] hover:text-[var(--reader-text)] hover:border-[var(--theme-accent)]/40 shrink-0 transition-all cursor-pointer"
          >
            {GENRE_MAP[getGenreSlug(g)]?.icon || '•'} {g}
          </button>
        ))}
      </div>

    </div>

    <!-- Novel Grid Container: 2 on Mobile, 3 on Tablet, 4 on Desktop -->
    <div
      id="novels-catalog-grid"
      class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 gap-3.5 sm:gap-6"
    >
      {sortedNovels.map((novel) => (
        <NovelCard
          id={novel.id}
          title={novel.data.title}
          author={novel.data.author}
          authorSlug={novel.data.authorSlug}
          coverImage={novel.data.coverImage}
          synopsis={novel.data.synopsis}
          genres={novel.data.genres}
          status={novel.data.status}
          chapterCount={novelChapterCounts[novel.id] || 1}
        />
      ))}
    </div>

    <!-- Search / Filter Empty State -->
    <div id="catalog-empty-state" class="hidden py-16 text-center space-y-3 bg-[var(--reader-panel)] rounded-3xl border border-[var(--reader-border)]">
      <div class="text-3xl">🔍</div>
      <h3 class="text-base font-bold text-[var(--reader-text)] font-serif">නවකතා හමු නොවීය</h3>
      <p class="text-xs text-[var(--reader-muted)]">ඔබ සොයන නිර්ණායකවලට ගැලපෙන නවකතා නොමැත.</p>
      <button id="btn-reset-catalog" class="text-xs font-semibold accent-text hover:underline cursor-pointer">
        පෙරහන් ඉවත් කර නැවත පෙන්වන්න
      </button>
    </div>

  </div>

  <!-- Client-Side Filter & Live Search Script -->
  <script>
    let activeStatus = 'all';
    let activeGenre = 'all';
    let searchQuery = '';

    const cards = document.querySelectorAll('[data-novel-card]');
    const emptyState = document.getElementById('catalog-empty-state');
    const searchInput = document.getElementById('novel-search-input') as HTMLInputElement;

    const applyFilters = () => {
      let visible = 0;
      cards.forEach(card => {
        const title = card.querySelector('h3')?.textContent?.toLowerCase() || '';
        const author = card.querySelector('[data-novel-card] a')?.textContent?.toLowerCase() || '';
        const status = card.getAttribute('data-status') || '';
        const genres = (card.getAttribute('data-genres') || '').split(',');

        const matchesSearch = !searchQuery || title.includes(searchQuery) || author.includes(searchQuery);
        const matchesStatus = activeStatus === 'all' || status.toLowerCase() === activeStatus.toLowerCase();
        const matchesGenre = activeGenre === 'all' || genres.some(g => g.trim() === activeGenre);

        if (matchesSearch && matchesStatus && matchesGenre) {
          (card as HTMLElement).style.display = 'flex';
          visible++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (emptyState) {
        if (visible === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    };

    // Live search input
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      applyFilters();
    });

    // Status filter
    document.querySelectorAll('.status-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.status-btn').forEach(b => {
          b.className = 'status-btn px-3 py-1.5 rounded-lg text-[var(--reader-muted)] hover:text-[var(--reader-text)] transition-all cursor-pointer';
        });
        btn.className = 'status-btn px-3 py-1.5 rounded-lg accent-bg font-semibold shadow-xs transition-all cursor-pointer';
        activeStatus = btn.getAttribute('data-filter-status') || 'all';
        applyFilters();
      });
    });

    // Genre filter
    document.querySelectorAll('.genre-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.genre-btn').forEach(b => {
          b.className = 'genre-btn px-3 py-1.5 rounded-xl bg-[var(--reader-bg)] border border-[var(--reader-border)] text-[var(--reader-muted)] hover:text-[var(--reader-text)] shrink-0 transition-all cursor-pointer';
        });
        btn.className = 'genre-btn px-3 py-1.5 rounded-xl accent-badge font-semibold shrink-0 transition-all border border-[var(--theme-accent)]/30 cursor-pointer';
        activeGenre = btn.getAttribute('data-filter-genre') || 'all';
        applyFilters();
      });
    });

    // Reset button
    document.getElementById('btn-reset-catalog')?.addEventListener('click', () => {
      activeStatus = 'all';
      activeGenre = 'all';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      (document.querySelector('.status-btn[data-filter-status="all"]') as HTMLElement)?.click();
      (document.querySelector('.genre-btn[data-filter-genre="all"]') as HTMLElement)?.click();
    });
  </script>
</BaseLayout>
