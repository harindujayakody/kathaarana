---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const novels = await getCollection('novels');
  const allChapters = await getCollection('chapters');

  return novels.map((novel) => {
    const chapters = allChapters
      .filter((c) => c.data.novel === novel.id)
      .sort((a, b) => a.data.chapterNumber - b.data.chapterNumber);

    return {
      params: { novel: novel.id },
      props: { novel, chapters },
    };
  });
}

const { novel, chapters } = Astro.props;
const firstChapterUrl = chapters.length > 0 ? `/novels/${novel.id}/${chapters[0].data.chapterNumber}` : '#';
const totalWords = chapters.reduce((acc, curr) => acc + (curr.data.wordCount || 0), 0);
---

<BaseLayout
  title={`${novel.data.title} - සිංහල නවකතාව`}
  description={novel.data.synopsis}
  image={novel.data.coverImage}
  novel={{
    title: novel.data.title,
    author: novel.data.author,
    coverImage: novel.data.coverImage,
    synopsis: novel.data.synopsis,
    url: Astro.url.href,
  }}
>
  <div class="max-w-4xl mx-auto px-4 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav class="mb-6 flex items-center gap-2 text-xs text-[var(--reader-muted)]">
      <a href="/" class="hover:underline">මුල් පිටුව</a>
      <span>/</span>
      <span class="text-[var(--reader-text)] font-semibold">{novel.data.title}</span>
    </nav>

    <!-- Novel Header Card -->
    <div class="bg-[var(--reader-panel)] border border-[var(--reader-border)] rounded-3xl p-6 sm:p-8 flex flex-col md:flex-row gap-8 items-start">
      <div class="w-full sm:w-60 md:w-64 shrink-0 mx-auto md:mx-0">
        <div class="rounded-2xl overflow-hidden shadow-xl border border-[var(--reader-border)] aspect-[2/3]">
          <img src={novel.data.coverImage} alt={novel.data.title} class="w-full h-full object-cover" />
        </div>
      </div>

      <div class="flex-1 space-y-4">
        <div class="flex flex-wrap gap-2">
          {novel.data.genres.map(g => (
            <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-[var(--reader-border)]/40 text-[var(--reader-muted)] border border-[var(--reader-border)]/60">
              {g}
            </span>
          ))}
        </div>

        <h1 class="text-3xl font-bold font-serif text-[var(--reader-text)]">{novel.data.title}</h1>
        <p class="text-sm text-[var(--reader-muted)]">
          කර්තෘ: <a href={`/authors/${novel.data.authorSlug}`} class="font-semibold text-emerald-700 dark:text-emerald-400 hover:underline">{novel.data.author}</a>
        </p>
        <p class="text-sm leading-relaxed text-[var(--reader-text)]/90 italic border-l-2 border-emerald-600/40 pl-3">
          "{novel.data.synopsis}"
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 py-2 border-y border-[var(--reader-border)] text-xs">
          <div><span class="text-[var(--reader-muted)]">පරිච්ඡේද:</span> <strong class="text-[var(--reader-text)] ml-1">{chapters.length}</strong></div>
          <div><span class="text-[var(--reader-muted)]">වචන එකතුව:</span> <strong class="text-[var(--reader-text)] ml-1">{totalWords.toLocaleString()}</strong></div>
          <div><span class="text-[var(--reader-muted)]">තත්ත්වය:</span> <strong class="text-emerald-600 dark:text-emerald-400 ml-1">{novel.data.status === 'Ongoing' ? 'ලියවෙමින් පවතී' : 'සම්පූර්ණයි'}</strong></div>
        </div>

        <div class="pt-2">
          <a
            href={firstChapterUrl}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-sm shadow-md transition-all"
          >
            කියවීම අරඹන්න (1 වන පරිච්ඡේදය) →
          </a>
        </div>
      </div>
    </div>

    <!-- Chapter List -->
    <div class="mt-10 space-y-3">
      <h2 class="text-xl font-bold text-[var(--reader-text)] pb-2 border-b border-[var(--reader-border)]">
        සියලු පරිච්ඡේද
      </h2>

      <div class="grid gap-2.5">
        {chapters.map((ch) => (
          <a
            href={`/novels/${novel.id}/${ch.data.chapterNumber}`}
            class="flex items-center justify-between p-4 rounded-2xl bg-[var(--reader-panel)] border border-[var(--reader-border)] hover:border-emerald-600/40 transition-colors"
          >
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-xl bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 font-bold flex items-center justify-center text-xs">
                {ch.data.chapterNumber}
              </span>
              <div>
                <span class="font-medium text-sm text-[var(--reader-text)]">
                  පරිච්ඡේදය {ch.data.chapterNumber}: {ch.data.title}
                </span>
                <span class="text-xs text-[var(--reader-muted)] ml-2">• වචන {ch.data.wordCount || 850}</span>
              </div>
            </div>
            <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-400">කියවන්න →</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
