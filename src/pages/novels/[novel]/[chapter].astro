---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReaderControls from '../../../components/ReaderControls.astro';
import Icon from '../../../components/Icon.astro';
import RatingStars from '../../../components/RatingStars.astro';
import { getCollection, render } from 'astro:content';
import { coverShareUrl, coverThumbUrl } from '../../../utils/covers';
import { chapterWords } from '../../../utils/wordCount';

export async function getStaticPaths() {
  const allChapters = await getCollection('chapters');
  const allNovels = await getCollection('novels');

  return allChapters.map((chapter) => {
    const parentNovel = allNovels.find((n) => n.id === chapter.data.novel);
    if (!parentNovel) throw new Error(`Chapter ${chapter.id} points to unknown novel "${chapter.data.novel}"`);

    // Get sibling chapters for navigation and TOC
    const siblings = allChapters
      .filter((c) => c.data.novel === chapter.data.novel)
      .sort((a, b) => a.data.chapterNumber - b.data.chapterNumber);

    const currentIndex = siblings.findIndex((c) => c.id === chapter.id);
    const prevChapter = currentIndex > 0 ? siblings[currentIndex - 1] : null;
    const nextChapter = currentIndex < siblings.length - 1 ? siblings[currentIndex + 1] : null;

    return {
      params: {
        novel: chapter.data.novel,
        chapter: chapter.data.chapterNumber.toString(),
      },
      props: {
        chapter,
        novel: parentNovel,
        siblings,
        prevChapter,
        nextChapter,
      },
    };
  });
}

const { chapter, novel, siblings, prevChapter, nextChapter } = Astro.props;
const { Content } = await render(chapter);
const shareCover = await coverShareUrl(novel.data.coverImage);
const thumbCover = await coverThumbUrl(novel.data.coverImage);

// The chapter's own source if it has one, otherwise the novel's.
// A source that is a web address is shown as a link; anything else as plain text.
const source = chapter.data.source ?? novel.data.source;
const sourceIsLink = !!source && /^https?:\/\//.test(source);
// The button shows the site's name, not the whole address: facebook.com -> Facebook.
const sourceHost = sourceIsLink ? new URL(source).hostname.replace(/^(www|m|web)\./, '') : '';
const sourceLabel = /(^|\.)(facebook\.com|fb\.com|fb\.me)$/.test(sourceHost) ? 'Facebook' : sourceHost;

const words = chapterWords(chapter);
const readTimeMinutes = Math.max(1, Math.ceil(words / 180));
const formattedDate = chapter.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const prevUrl = prevChapter ? `/novels/${novel.id}/${prevChapter.data.chapterNumber}/` : undefined;
const nextUrl = nextChapter ? `/novels/${novel.id}/${nextChapter.data.chapterNumber}/` : undefined;

const chapterList = siblings.map((s) => ({
  number: s.data.chapterNumber,
  title: s.data.title,
  url: `/novels/${novel.id}/${s.data.chapterNumber}/`,
  isCurrent: s.data.chapterNumber === chapter.data.chapterNumber,
}));

// Emoji are the content here, not stand-ins for icons: readers pick the face that matches.
const reactions = [
  { kind: 'like', emoji: '❤️', label: 'ආදරෙයි' },
  { kind: 'haha', emoji: '😂', label: 'හිනා ගියා' },
  { kind: 'wow', emoji: '😮', label: 'පුදුමයි' },
  { kind: 'sad', emoji: '😢', label: 'දුකයි' },
  { kind: 'fire', emoji: '🔥', label: 'සුපිරි' },
];
---

<BaseLayout
  title={`${novel.data.title} - පරිච්ඡේදය ${chapter.data.chapterNumber}: ${chapter.data.title}`}
  description={`${novel.data.title} නවකතාවේ ${chapter.data.chapterNumber} වන පරිච්ඡේදය. කර්තෘ: ${novel.data.author}.`}
  image={`/og/${novel.id}.jpg`}
  type="article"
  publishDate={chapter.data.publishDate}
  reading
  novel={{
    title: novel.data.title,
    author: novel.data.author,
    coverImage: shareCover,
    synopsis: novel.data.synopsis,
    url: new URL(`/novels/${novel.id}/`, Astro.site || 'https://kathaarana.com').toString(),
  }}
  chapter={{
    number: chapter.data.chapterNumber,
    title: chapter.data.title,
    wordCount: words,
  }}
>
  <article
    class="mx-auto max-w-[54rem] space-y-4 sm:px-6 sm:py-6 lg:py-8"
    data-chapter-page
    data-novel-id={novel.id}
    data-novel-title={novel.data.title}
    data-novel-cover={thumbCover}
    data-author={novel.data.author}
    data-chapter={chapter.data.chapterNumber}
    data-chapter-title={chapter.data.title}
  >
    <!-- The reading card: edge to edge on phones, a card from tablet up -->
    <div class="surface rounded-none border-x-0 border-t-0 px-5 py-7 sm:rounded-[14px] sm:border sm:px-10 sm:py-10">
      <nav aria-label="Breadcrumb" class="mb-5 hidden items-center gap-2 text-sm text-[var(--reader-muted)] sm:flex">
        <a href="/" class="hover:text-[var(--reader-text)]">මුල් පිටුව</a>
        <span aria-hidden="true">/</span>
        <a href={`/novels/${novel.id}/`} class="max-w-xs truncate hover:text-[var(--reader-text)]">{novel.data.title}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">පරිච්ඡේදය {chapter.data.chapterNumber}</span>
      </nav>

      <header class="border-b border-[var(--reader-border)] pb-6">
        <h1 class="text-2xl font-bold leading-[1.4] text-balance sm:text-3xl">{chapter.data.title}</h1>
        <p class="mt-2 text-[0.9375rem]">
          <a href={`/novels/${novel.id}/`} class="font-medium accent-text">{novel.data.title}</a>
          <span class="text-[var(--reader-muted)]"> · පරිච්ඡේදය {chapter.data.chapterNumber} / {siblings.length}</span>
        </p>
        <p class="mt-1 flex flex-wrap gap-x-3 text-sm text-[var(--reader-muted)]">
          <a href={`/authors/${novel.data.authorSlug}/`} class="hover:text-[var(--reader-text)]">{novel.data.author}</a>
          <time datetime={chapter.data.publishDate.toISOString()}>{formattedDate}</time>
          <span>විනාඩි {readTimeMinutes}ක කියවීමක්</span>
        </p>
      </header>

      <div id="chapter-content" class="novel-prose font-novel-sans mx-auto mt-7 max-w-[46rem]">
        <Content />
      </div>

      {source && (
        <div class="mx-auto mt-10 flex max-w-[46rem] flex-wrap items-center gap-x-3 gap-y-2 border-t border-[var(--reader-border)] pt-5 text-sm">
          <span class="text-[var(--reader-muted)]">මුලාශ්‍රය</span>
          {sourceIsLink ? (
            <a
              href={source}
              target="_blank"
              rel="noopener noreferrer nofollow"
              title={source}
              class="tap inline-flex items-center gap-1.5 rounded-full border border-[var(--reader-border)] px-3.5 py-1.5 font-medium hover:border-[var(--reader-text)]"
            >
              {sourceLabel}
              <Icon name="external" class="h-3.5 w-3.5 text-[var(--reader-muted)]" />
            </a>
          ) : (
            <span class="font-medium">{source}</span>
          )}
        </div>
      )}
    </div>

    <!-- Reactions -->
    <section class="surface mx-4 p-4 sm:mx-0 sm:p-5" aria-labelledby="react-title">
      <h2 id="react-title" class="text-lg font-bold">මෙම පරිච්ඡේදය කොහොමද?</h2>
      <div data-reactions class="mt-3 flex flex-wrap gap-2">
        {reactions.map((r) => (
          <button
            type="button"
            data-kind={r.kind}
            aria-pressed="false"
            title={r.label}
            class="tap flex cursor-pointer items-center gap-1.5 rounded-full border border-[var(--reader-border)] px-3.5 py-2"
          >
            <span class="text-xl leading-none" role="img" aria-label={r.label}>{r.emoji}</span>
            <span data-count class="text-sm font-semibold tabular-nums">0</span>
          </button>
        ))}
      </div>
    </section>

    <!-- Rate the novel -->
    <section class="surface mx-4 p-4 sm:mx-0 sm:p-5" data-stats={novel.id} aria-labelledby="rate-title">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="rate-title" class="text-lg font-bold">නවකතාව අගයන්න</h2>
        <span class="inline-flex items-center gap-1 text-sm">
          <Icon name="star" class="h-4 w-4 fill-current text-[var(--star)]" />
          <span data-s="rating" class="font-semibold tabular-nums">–</span>
          <span data-s="ratings" class="text-xs text-[var(--reader-muted)]"></span>
        </span>
      </div>
      <div class="mt-2">
        <RatingStars novelId={novel.id} />
      </div>
    </section>

    <!-- Where next -->
    <nav class="mx-4 grid gap-3 sm:mx-0 sm:grid-cols-2" aria-label="පරිච්ඡේද අතර">
      {prevUrl && prevChapter ? (
        <a href={prevUrl} class="surface tap flex items-center gap-3 p-4">
          <Icon name="left" class="h-5 w-5 shrink-0 text-[var(--reader-muted)]" />
          <span class="min-w-0">
            <span class="block text-sm text-[var(--reader-muted)]">පෙර පරිච්ඡේදය</span>
            <span class="block truncate font-medium">{prevChapter.data.title}</span>
          </span>
        </a>
      ) : (
        <a href={`/novels/${novel.id}/`} class="surface tap flex items-center gap-3 p-4">
          <Icon name="list" class="h-5 w-5 shrink-0 text-[var(--reader-muted)]" />
          <span class="font-medium">සියලු පරිච්ඡේද</span>
        </a>
      )}
      {nextUrl && nextChapter ? (
        <a href={nextUrl} class="surface tap flex items-center justify-end gap-3 border-[var(--theme-accent)] p-4 text-right">
          <span class="min-w-0">
            <span class="block text-sm accent-text">ඊළඟ පරිච්ඡේදය</span>
            <span class="block truncate font-medium">{nextChapter.data.title}</span>
          </span>
          <Icon name="right" class="h-5 w-5 shrink-0 accent-text" />
        </a>
      ) : (
        <a href={`/novels/${novel.id}/`} class="surface tap flex items-center justify-end gap-3 p-4 text-right">
          <span class="min-w-0">
            <span class="block text-sm text-[var(--reader-muted)]">මෙතෙක් පළ වූ අවසන් පරිච්ඡේදය</span>
            <span class="block font-medium">නවකතා පිටුවට</span>
          </span>
          <Icon name="right" class="h-5 w-5 shrink-0 text-[var(--reader-muted)]" />
        </a>
      )}
    </nav>
  </article>

  <ReaderControls
    novelSlug={novel.id}
    novelTitle={novel.data.title}
    chapters={chapterList}
    prevUrl={prevUrl}
    nextUrl={nextUrl}
    currentChapterNum={chapter.data.chapterNumber}
  />
</BaseLayout>
