---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import BookGrid from '../../components/BookGrid.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import ShelfButton from '../../components/ShelfButton.astro';
import { getImage } from 'astro:assets';
import RatingStars from '../../components/RatingStars.astro';
import { buildStats } from '../../utils/buildStats';
import { formatPrice } from '../../utils/price';
import { listSlug } from '../../utils/slug';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => {
    // Related: same author first, then same publisher, then shared genres; newest breaks ties.
    const score = (b: typeof book) =>
      (b.data.author === book.data.author ? 4 : 0) +
      (book.data.publisher && b.data.publisher === book.data.publisher ? 2 : 0) +
      b.data.genres.filter((g) => book.data.genres.includes(g)).length;
    const related = books
      .filter((b) => b.id !== book.id)
      .sort((a, b) => score(b) - score(a) || (b.data.addedDate?.getTime() ?? 0) - (a.data.addedDate?.getTime() ?? 0))
      .slice(0, 4);
    return { params: { book: book.id }, props: { book, related } };
  });
}

const { book, related } = Astro.props;
const { Content } = await render(book);
const { title, author, publisher, isbn, pages, print, binding, coverImage, images, genres, price } = book.data;
// Ratings are stored under the same key the catalog gives this book.
const ratingKey = `book-${book.id}`;
const rated = (await buildStats())[ratingKey];

const about = book.body?.trim() ?? '';
// First paragraph of "About this book", without Markdown marks, for search results.
const description =
  about
    .split(/\n\s*\n/)[0]
    ?.replace(/[*_#>`[\]]/g, '')
    .slice(0, 160) || `${title} - ${author}`;

// Each row's value is one or more parts; a part with an address is a link.
type Part = { text: string; href?: string };
// Shown as tiles, two to a row; long values (wide) take a full row, as does a short one left alone.
const shown = (
  [
    ['ප්‍රකාශක', publisher ? [{ text: publisher, href: `/books/publisher/${listSlug(publisher)}/` }] : [], true],
    ['ප්‍රභේදය', genres.map((g) => ({ text: g, href: `/books/genre/${listSlug(g)}/` })), false],
    ['පිටු ගණන', pages !== undefined ? [{ text: String(pages) }] : [], false],
    ['ISBN', isbn ? [{ text: isbn }] : [], false],
    ['බන්ධනය', binding ? [{ text: binding }] : [], false],
    ['මුද්‍රණ තත්වය', print ? [{ text: print }] : [], true],
  ] as [string, Part[], boolean][]
).filter(([, parts]) => parts.length > 0);
const halves = shown.filter(([, , wide]) => !wide);
const details = shown.map(([label, parts, wide]) => ({
  label,
  parts,
  wide: wide || (halves.length % 2 === 1 && halves.at(-1)?.[0] === label),
}));

const site = Astro.site ?? new URL('https://kathaarana.com');
const url = new URL(`/books/${book.id}/`, site).toString();
// The cover search engines and link previews show, with the logo like every book picture on the site.
const shareCover = new URL((await getImage({ src: coverImage, width: 800, format: 'jpeg', watermark: true })).src, site).toString();
// The full-screen viewer: the cover first, then the extra pictures.
const gallery = await Promise.all(
  [coverImage, ...images].map(async (src, i) => ({
    src: (await getImage({ src, width: 1000, format: 'webp', watermark: true })).src,
    alt: i === 0 ? `${title} කවරය` : `${title}: පින්තූරය ${i + 1}`,
  })),
);
// Small cover for the library list.
const shelfCover = (await getImage({ src: coverImage, width: 96, format: 'webp' })).src;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    '@id': `${url}#book`,
    name: title,
    author: { '@type': 'Person', name: author },
    publisher: publisher ? { '@type': 'Organization', name: publisher } : undefined,
    isbn,
    numberOfPages: pages,
    genre: genres.length ? genres : undefined,
    // The listed price, in rupees. There is no online ordering, so no purchase link.
    offers: price !== undefined ? { '@type': 'Offer', price: price.toFixed(2), priceCurrency: 'LKR', url } : undefined,
    // Only when readers have rated it; the same numbers are shown on the page.
    aggregateRating:
      rated && rated.ratings > 0
        ? { '@type': 'AggregateRating', ratingValue: rated.rating, ratingCount: rated.ratings, bestRating: 5, worstRating: 1 }
        : undefined,
    image: shareCover,
    inLanguage: 'si',
    url,
  },
  // The same book as something for sale, so search engines can show its price.
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${url}#product`,
    name: title,
    description,
    image: shareCover,
    url,
    sku: isbn ?? book.id,
    // An ISBN-13 is the book's GTIN-13.
    gtin13: isbn && /^97[89]\d{10}$/.test(isbn.replace(/-/g, '')) ? isbn.replace(/-/g, '') : undefined,
    brand: publisher ? { '@type': 'Brand', name: publisher } : undefined,
    category: 'Books',
    subjectOf: { '@id': `${url}#book` },
    offers:
      price !== undefined
        ? { '@type': 'Offer', price: price.toFixed(2), priceCurrency: 'LKR', url, itemCondition: 'https://schema.org/NewCondition' }
        : undefined,
    aggregateRating:
      rated && rated.ratings > 0
        ? { '@type': 'AggregateRating', ratingValue: rated.rating, ratingCount: rated.ratings, bestRating: 5, worstRating: 1 }
        : undefined,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'කතා අරණ', item: site.toString() },
      { '@type': 'ListItem', position: 2, name: 'පොත් සාප්පුව', item: new URL('/books/', site).toString() },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
].filter((s) => s['@type'] !== 'Product' || s.offers || s.aggregateRating); // Google ignores a Product with neither.
---

<BaseLayout title={`${title} - ${author}`} description={description} image={`/og/book-${book.id}.jpg`} type="book" jsonLd={jsonLd}>
  <!-- Phones: one column (book, rating, about, details). Wide screens: book and about on the left,
       details and rating in a right column that stays in view. -->
  <div class="mx-auto flex max-w-[90rem] flex-col gap-6 px-4 py-5 sm:px-6 lg:px-8 lg:py-8 xl:grid xl:grid-cols-[minmax(0,1fr)_21rem] xl:items-start">
    <div class="contents xl:block xl:min-w-0 xl:space-y-6">
        <section class="surface order-1 p-4 sm:p-6" data-stats={ratingKey} data-book-view={ratingKey}>
          <!-- Phones: library and share buttons get a full-width row under the cover; wider: they sit under the title. -->
          <div class="grid grid-cols-[8rem_minmax(0,1fr)] gap-x-4 sm:grid-cols-[13rem_minmax(0,1fr)] sm:grid-rows-[auto_1fr] sm:gap-x-6">
            <button type="button" data-gallery-open="0" class="tap self-start cursor-zoom-in sm:row-span-2" aria-label={`${title} කවරය විශාලව බලන්න`}>
              <Image
                src={coverImage}
                alt={`${title} කවරය`}
                widths={[128, 208, 256, 416]}
                sizes="(min-width: 640px) 208px, 128px"
                loading="eager"
                fetchpriority="high"
                watermark
                class="aspect-[2/3] w-full rounded-lg object-cover shadow-[var(--lift-shadow)]"
              />
            </button>
            <div class="min-w-0">
              <h1 class="text-2xl font-bold leading-snug sm:text-3xl">{title}</h1>
              <p class="mt-1 text-[0.9375rem] font-medium"><a href={`/books/author/${listSlug(author)}/`} class="hover:accent-text hover:underline">{author}</a></p>
              <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-[var(--reader-muted)]">
                <span class="inline-flex items-center gap-1">
                  <Icon name="star" class="h-4 w-4 fill-current text-[var(--star)]" />
                  <span data-s="rating" class="font-semibold tabular-nums text-[var(--reader-text)]">–</span>
                  <span data-s="ratings" class="text-xs"></span>
                </span>
                <span class="inline-flex items-center gap-1" title="නැරඹුම්">
                  <Icon name="eye" class="h-4 w-4" /><span data-s="views" class="tabular-nums">0</span>
                  <span class="sr-only">නැරඹුම්</span>
                </span>
              </p>
            </div>
            <div class="col-span-2 mt-4 sm:col-span-1 sm:col-start-2">
              <ShelfButton id={book.id} title={title} author={author} cover={shelfCover} url={`/books/${book.id}/`} class="[&>[data-shelf-open]]:flex-1 sm:[&>[data-shelf-open]]:flex-none" />
              <ShareButtons url={url} title={`${title} - ${author}`} card={`/share/book-${book.id}.jpg`} class="mt-4" />
              {images.length > 0 && (
                <div class="mt-4">
                  <p class="text-sm text-[var(--reader-muted)]">තවත් පින්තූර</p>
                  <ul class="mt-2 flex gap-2 overflow-x-auto pb-1">
                    {images.map((src, i) => (
                      <li class="shrink-0">
                        <button type="button" data-gallery-open={i + 1} class="tap block cursor-zoom-in overflow-hidden rounded-lg border border-[var(--reader-border)]" aria-label={`පින්තූරය ${i + 2} විශාලව බලන්න`}>
                          <Image src={src} alt={gallery[i + 1].alt} widths={[64, 128]} sizes="64px" class="h-24 w-16 object-cover" />
                        </button>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        </section>

        <!-- Full-screen viewer for the cover and the extra pictures. -->
        <dialog id="book-gallery" class="gallery" aria-label="පින්තූර" data-gallery={JSON.stringify(gallery)}>
          <div class="flex h-full flex-col">
            <div class="flex items-center justify-between px-4 py-3 text-sm text-white/80">
              <span data-gallery-count class="tabular-nums"></span>
              <button type="button" data-gallery-close class="tap cursor-pointer rounded-lg p-2 text-white" aria-label="වසන්න"><Icon name="close" /></button>
            </div>
            <div class="relative flex min-h-0 flex-1 items-center justify-center px-4 pb-6 sm:px-16">
              <img data-gallery-img alt="" class="max-h-full max-w-full rounded-lg object-contain" />
              {gallery.length > 1 && (
                <>
                  <button type="button" data-gallery-step="-1" class="tap absolute left-2 top-1/2 grid h-11 w-11 -translate-y-1/2 cursor-pointer place-items-center rounded-full bg-white/15 text-white hover:bg-white/25" aria-label="පෙර පින්තූරය"><Icon name="left" /></button>
                  <button type="button" data-gallery-step="1" class="tap absolute right-2 top-1/2 grid h-11 w-11 -translate-y-1/2 cursor-pointer place-items-center rounded-full bg-white/15 text-white hover:bg-white/25" aria-label="ඊළඟ පින්තූරය"><Icon name="right" /></button>
                </>
              )}
            </div>
          </div>
        </dialog>

        {about && (
          <section class="surface order-3 p-4 sm:p-6" aria-labelledby="about-title">
            <h2 id="about-title" class="text-lg font-bold">මෙම පොත ගැන</h2>
            <div class="novel-prose mt-3 max-w-[42rem] [&_p:last-child]:mb-0">
              <Content />
            </div>
          </section>
        )}

        {related.length > 0 && (
          <section class="order-5" aria-labelledby="related-title">
            <h2 id="related-title" class="mb-3 text-lg font-bold">සම්බන්ධ පොත්</h2>
            <BookGrid books={related} lazy columns="grid-cols-2 sm:grid-cols-4" />
          </section>
        )}

        <a href="/books/" class="tap order-6 inline-flex items-center gap-1 text-sm font-medium accent-text">
          <Icon name="left" class="h-4 w-4" />
          සියලු පොත්
        </a>
    </div>

    <aside class="contents xl:[@media(min-height:66rem)]:sticky xl:top-6 xl:block xl:space-y-6 xl:pb-1">
        {(details.length > 0 || price !== undefined) && (
          <section class="surface order-4 p-4 sm:p-6" aria-labelledby="details-title">
            <h2 id="details-title" class="text-lg font-bold">විස්තර</h2>
            {price !== undefined && (
              <p class="mt-3 flex items-baseline justify-between gap-3 border-b border-[var(--reader-border)] pb-3">
                <span class="text-sm text-[var(--reader-muted)]">මිල</span>
                <span class="text-2xl font-bold tabular-nums">{formatPrice(price)}</span>
              </p>
            )}
            <dl class="mt-3 grid grid-cols-2 gap-2">
              {details.map(({ label, parts, wide }) => (
                <div class:list={['min-w-0 rounded-lg bg-[var(--reader-bg)] px-3 py-2.5', wide && 'col-span-2']}>
                  <dt class="text-xs text-[var(--reader-muted)]">{label}</dt>
                  <dd class="mt-0.5 text-[0.9375rem] font-medium leading-snug tabular-nums [overflow-wrap:anywhere]">
                    {parts.map((p, i) => (
                      <>
                        {i > 0 && ', '}
                        {p.href ? (
                          <a href={p.href} class="underline decoration-[var(--reader-border)] underline-offset-4 hover:accent-text hover:decoration-current">{p.text}</a>
                        ) : (
                          p.text
                        )}
                      </>
                    ))}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <section class="surface order-2 p-4 sm:p-6" data-stats={ratingKey} aria-labelledby="rate-title">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 id="rate-title" class="text-lg font-bold">මෙම පොත අගයන්න</h2>
            <span data-s="ratings-long" class="text-sm text-[var(--reader-muted)]"></span>
          </div>
          <div class="mt-2">
            <RatingStars novelId={ratingKey} />
          </div>
        </section>
    </aside>
  </div>
</BaseLayout>

<script>
  // The picture viewer: opened from the cover or a thumbnail; arrows, swipe and ← → keys move through them.
  document.addEventListener('astro:page-load', () => {
    const dialog = document.getElementById('book-gallery') as HTMLDialogElement | null;
    if (!dialog) return;
    const pictures: { src: string; alt: string }[] = JSON.parse(dialog.dataset.gallery || '[]');
    const img = dialog.querySelector<HTMLImageElement>('[data-gallery-img]')!;
    const count = dialog.querySelector<HTMLElement>('[data-gallery-count]')!;
    let at = 0;
    const show = (i: number) => {
      at = (i + pictures.length) % pictures.length;
      img.src = pictures[at].src;
      img.alt = pictures[at].alt;
      count.textContent = pictures.length > 1 ? `${at + 1} / ${pictures.length}` : '';
    };
    document.querySelectorAll<HTMLButtonElement>('[data-gallery-open]').forEach((b) => {
      b.onclick = () => {
        show(Number(b.dataset.galleryOpen));
        dialog.showModal();
      };
    });
    dialog.querySelector<HTMLButtonElement>('[data-gallery-close]')!.onclick = () => dialog.close();
    dialog.querySelectorAll<HTMLButtonElement>('[data-gallery-step]').forEach((b) => {
      b.onclick = () => show(at + Number(b.dataset.galleryStep));
    });
    dialog.onkeydown = (e) => {
      if (e.key === 'ArrowRight') show(at + 1);
      else if (e.key === 'ArrowLeft') show(at - 1);
    };
    // Tap the dark area around the picture to close.
    dialog.onclick = (e) => {
      if (e.target === dialog || (e.target as Element).matches('.gallery > div, .gallery > div > div')) dialog.close();
    };
    let startX = 0;
    dialog.ontouchstart = (e) => (startX = e.touches[0].clientX);
    dialog.ontouchend = (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50 && pictures.length > 1) show(at + (dx < 0 ? 1 : -1));
    };
  });
</script>
