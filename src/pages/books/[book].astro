---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import RatingStars from '../../components/RatingStars.astro';
import { coverShareUrl } from '../../utils/covers';
import { buildStats } from '../../utils/buildStats';
import { formatPrice } from '../../utils/price';
import { slugFromName } from '../../utils/slug';

export async function getStaticPaths() {
  return (await getCollection('books')).map((book) => ({ params: { book: book.id }, props: { book } }));
}

const { book } = Astro.props;
const { Content } = await render(book);
const { title, author, publisher, isbn, pages, print, binding, coverImage, genres, price } = book.data;
// Ratings are stored under the same key the catalog gives this book.
const ratingKey = `book-${book.id}`;
const rated = (await buildStats())[ratingKey];

const about = book.body?.trim() ?? '';
// First paragraph of "About this book", without Markdown marks, for search results.
const description =
  about
    .split(/\n\s*\n/)[0]
    ?.replace(/[*_#>`[\]]/g, '')
    .slice(0, 160) || `${title} - ${author}`;

const details = [
  ['ISBN', isbn],
  ['පිටු ගණන', pages],
  ['මුද්‍රණ තත්වය', print],
  ['බන්ධනය', binding],
].filter(([, value]) => value !== undefined && value !== '') as [string, string | number][];

const site = Astro.site ?? new URL('https://kathaarana.com');
const url = new URL(`/books/${book.id}/`, site).toString();
const shareCover = new URL(await coverShareUrl(coverImage), site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    '@id': `${url}#book`,
    name: title,
    author: { '@type': 'Person', name: author },
    publisher: publisher ? { '@type': 'Organization', name: publisher } : undefined,
    isbn,
    numberOfPages: pages,
    genre: genres.length ? genres : undefined,
    // The listed price, in rupees. There is no online ordering, so no purchase link.
    offers: price !== undefined ? { '@type': 'Offer', price: price.toFixed(2), priceCurrency: 'LKR', url } : undefined,
    // Only when readers have rated it; the same numbers are shown on the page.
    aggregateRating:
      rated && rated.ratings > 0
        ? { '@type': 'AggregateRating', ratingValue: rated.rating, ratingCount: rated.ratings, bestRating: 5, worstRating: 1 }
        : undefined,
    image: shareCover,
    inLanguage: 'si',
    url,
  },
  // The same book as something for sale, so search engines can show its price.
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${url}#product`,
    name: title,
    description,
    image: shareCover,
    url,
    sku: isbn ?? book.id,
    // An ISBN-13 is the book's GTIN-13.
    gtin13: isbn && /^97[89]\d{10}$/.test(isbn.replace(/-/g, '')) ? isbn.replace(/-/g, '') : undefined,
    brand: publisher ? { '@type': 'Brand', name: publisher } : undefined,
    category: 'Books',
    subjectOf: { '@id': `${url}#book` },
    offers:
      price !== undefined
        ? { '@type': 'Offer', price: price.toFixed(2), priceCurrency: 'LKR', url, itemCondition: 'https://schema.org/NewCondition' }
        : undefined,
    aggregateRating:
      rated && rated.ratings > 0
        ? { '@type': 'AggregateRating', ratingValue: rated.rating, ratingCount: rated.ratings, bestRating: 5, worstRating: 1 }
        : undefined,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'කතා අරණ', item: site.toString() },
      { '@type': 'ListItem', position: 2, name: 'පොත් සාප්පුව', item: new URL('/books/', site).toString() },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
].filter((s) => s['@type'] !== 'Product' || s.offers || s.aggregateRating); // Google ignores a Product with neither.
---

<BaseLayout title={`${title} - ${author}`} description={description} image={`/og/book-${book.id}.jpg`} type="book" jsonLd={jsonLd}>
  <!-- Phones: one column (book, rating, about, details). Wide screens: book and about on the left,
       details and rating in a right column that stays in view. -->
  <div class="mx-auto flex max-w-[90rem] flex-col gap-6 px-4 py-5 sm:px-6 lg:px-8 lg:py-8 xl:grid xl:grid-cols-[minmax(0,1fr)_21rem] xl:items-start">
    <div class="contents xl:block xl:min-w-0 xl:space-y-6">
        <section class="surface order-1 p-4 sm:p-6" data-stats={ratingKey}>
          <div class="grid grid-cols-[8rem_minmax(0,1fr)] gap-x-4 sm:grid-cols-[13rem_minmax(0,1fr)] sm:gap-x-6">
            <Image
              src={coverImage}
              alt={`${title} කවරය`}
              widths={[128, 208, 256, 416]}
              sizes="(min-width: 640px) 208px, 128px"
              loading="eager"
              fetchpriority="high"
              class="aspect-[2/3] w-full self-start rounded-lg object-cover shadow-[var(--lift-shadow)]"
            />
            <div class="min-w-0">
              <h1 class="text-2xl font-bold leading-snug sm:text-3xl">{title}</h1>
              <p class="mt-1 text-[0.9375rem] font-medium"><a href={`/books/author/${slugFromName(author)}/`} class="hover:accent-text hover:underline">{author}</a></p>
              {publisher && (
                <p class="mt-2 text-sm text-[var(--reader-muted)]">
                  ප්‍රකාශක: <a href={`/books/publisher/${slugFromName(publisher)}/`} class="text-[var(--reader-text)] hover:underline">{publisher}</a>
                </p>
              )}
              {price !== undefined && <p class="mt-3 text-xl font-bold tabular-nums" aria-label={`මිල ${formatPrice(price)}`}>{formatPrice(price)}</p>}
              {genres.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="ප්‍රභේද">
                  {genres.map((g) => (
                    <li class="rounded-full border border-[var(--reader-border)] px-3 py-1 text-sm text-[var(--reader-muted)]">{g}</li>
                  ))}
                </ul>
              )}
              <p class="mt-3 inline-flex items-center gap-1 text-sm">
                <Icon name="star" class="h-4 w-4 fill-current text-[var(--star)]" />
                <span data-s="rating" class="font-semibold tabular-nums">–</span>
                <span data-s="ratings" class="text-xs text-[var(--reader-muted)]"></span>
              </p>
            </div>
          </div>
        </section>

        {about && (
          <section class="surface order-3 p-4 sm:p-6" aria-labelledby="about-title">
            <h2 id="about-title" class="text-lg font-bold">මෙම පොත ගැන</h2>
            <div class="novel-prose mt-3 max-w-[42rem] [&_p:last-child]:mb-0">
              <Content />
            </div>
          </section>
        )}

        <a href="/books/" class="tap order-5 inline-flex items-center gap-1 text-sm font-medium accent-text">
          <Icon name="left" class="h-4 w-4" />
          සියලු පොත්
        </a>
    </div>

    <aside class="contents xl:[@media(min-height:66rem)]:sticky xl:top-6 xl:block xl:space-y-6 xl:pb-1">
        {details.length > 0 && (
          <section class="surface order-4 p-4 sm:p-6" aria-labelledby="details-title">
            <h2 id="details-title" class="text-lg font-bold">විස්තර</h2>
            <dl class="mt-2 divide-y divide-[var(--reader-border)]">
              {details.map(([label, value]) => (
                <div class="flex items-baseline justify-between gap-4 py-2.5 text-[0.9375rem]">
                  <dt class="text-[var(--reader-muted)]">{label}</dt>
                  <dd class="text-right font-medium tabular-nums">{value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <section class="surface order-2 p-4 sm:p-6" data-stats={ratingKey} aria-labelledby="rate-title">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 id="rate-title" class="text-lg font-bold">මෙම පොත අගයන්න</h2>
            <span data-s="ratings-long" class="text-sm text-[var(--reader-muted)]"></span>
          </div>
          <div class="mt-2">
            <RatingStars novelId={ratingKey} />
          </div>
        </section>
    </aside>
  </div>
</BaseLayout>
