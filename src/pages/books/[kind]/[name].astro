---
// Every book by one author (/books/author/<name>/) or from one publisher (/books/publisher/<name>/).
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BookGrid from '../../../components/BookGrid.astro';
import Icon from '../../../components/Icon.astro';
import { slugFromName } from '../../../utils/slug';

export async function getStaticPaths() {
  const books = await getCollection('books');
  const paths: { params: { kind: string; name: string }; props: { kind: string; label: string; books: CollectionEntry<'books'>[] } }[] = [];
  for (const kind of ['author', 'publisher'] as const) {
    const groups = new Map<string, { label: string; books: CollectionEntry<'books'>[] }>();
    for (const book of books) {
      const label = book.data[kind];
      if (!label) continue;
      const slug = slugFromName(label);
      if (!groups.has(slug)) groups.set(slug, { label, books: [] });
      groups.get(slug)!.books.push(book);
    }
    for (const [slug, group] of groups) paths.push({ params: { kind, name: slug }, props: { kind, ...group } });
  }
  return paths;
}

const { kind, label, books } = Astro.props;
books.sort((a, b) => (b.data.addedDate?.getTime() ?? 0) - (a.data.addedDate?.getTime() ?? 0) || a.data.title.localeCompare(b.data.title, 'si'));
const role = kind === 'author' ? 'කතුවරයා' : 'ප්‍රකාශක';
const title = kind === 'author' ? `${label} ගේ පොත්` : `${label} ප්‍රකාශන`;
---

<BaseLayout title={title} description={`${role}: ${label}. කතා අරණ පොත් සාප්පුවේ පොත් ${books.length}ක්.`}>
  <div class="mx-auto max-w-[90rem] px-4 py-5 sm:px-6 lg:px-8 lg:py-8">
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-[var(--reader-muted)]">
      <a href="/books/" class="inline-flex items-center gap-1 hover:text-[var(--reader-text)]"><Icon name="left" class="h-4 w-4" />පොත් සාප්පුව</a>
    </nav>
    <header class="mt-3">
      <p class="text-sm text-[var(--reader-muted)]">{role}</p>
      <h1 class="text-2xl font-bold leading-snug sm:text-3xl">{label}</h1>
      <p class="mt-1 text-[0.9375rem] text-[var(--reader-muted)]">පොත් {books.length}</p>
    </header>
    <div class="mt-5">
      <BookGrid books={books} />
    </div>
  </div>
</BaseLayout>
