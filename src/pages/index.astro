---
import BaseLayout from '../layouts/BaseLayout.astro';
import NovelCard from '../components/NovelCard.astro';
import { getCollection } from 'astro:content';
import { GENRE_MAP, getGenreSlug } from '../utils/genres';

const novels = await getCollection('novels');
const allChapters = await getCollection('chapters');

// Sort novels by publishDate
const sortedNovels = novels.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const featuredNovel = sortedNovels[0];

// Extract unique authors
const uniqueAuthors = Array.from(
  new Set(novels.map(n => JSON.stringify({ name: n.data.author, slug: n.data.authorSlug })))
).map(s => JSON.parse(s));

// Map chapter count per novel
const novelChapterCounts: Record<string, number> = {};
allChapters.forEach(c => {
  novelChapterCounts[c.data.novel] = (novelChapterCounts[c.data.novel] || 0) + 1;
});

// Sort all chapters descending for "Latest Chapter Releases"
const latestChapters = allChapters
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);

// Featured novel chapters
const featuredChapters = allChapters
  .filter(c => c.data.novel === featuredNovel.id)
  .sort((a, b) => a.data.chapterNumber - b.data.chapterNumber);

const featuredFirstChapterUrl = featuredChapters.length > 0
  ? `/novels/${featuredNovel.id}/${featuredChapters[0].data.chapterNumber}`
  : `/novels/${featuredNovel.id}`;

// Unique genres across all novels
const allGenres = Array.from(new Set(novels.flatMap(n => n.data.genres)));
---

<BaseLayout
  title="කතා අරණ - සිංහල නවකතා කියවීමේ නිදහස් අවකාශය | Realm of Sinhala Web Novels"
  description="ශ්‍රී ලාංකේය ලේඛකයන්ගේ සිංහල නවකතා, අබිරහස්, ත්‍රාසජනක සහ ආදර කතා ජංගම දුරකථනයෙන් පහසුවෙන් කියවන්න. නොමිලේ, ගිණුම් අවශ්‍ය නැත."
  image={featuredNovel.data.coverImage}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-16">
    
    <!-- Platform Hero & Orientation -->
    <section class="relative rounded-3xl bg-[var(--reader-panel)] border border-[var(--reader-border)] p-6 sm:p-10 overflow-hidden shadow-sm">
      <div class="absolute -right-20 -top-20 w-80 h-80 rounded-full bg-[var(--theme-accent)]/10 blur-3xl pointer-events-none"></div>

      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold accent-badge border border-[var(--theme-accent)]/20">
          <span class="w-2 h-2 rounded-full accent-bg animate-pulse"></span>
          <span>නොමිලේ සිංහල වෙබ් නවකතා එකතුව</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-[var(--reader-text)] leading-tight font-serif">
          සිංහල නවකතාවල අසීමිත ලෝකය ඔබේ ඇඟිලි තුඩුවලට
        </h1>

        <p class="text-sm sm:text-base text-[var(--reader-muted)] leading-relaxed font-novel-sans">
          ශ්‍රී ලාංකේය දක්ෂ ලේඛකයන්ගේ අබිරහස්, ත්‍රාසජනක, ආදර සහ ඓතිහාසික සිංහල නවකතා සහ කෙටිකතා කියවීමට නිර්මාණය කළ නිදහස් ඩිජිටල් අවකාශය. ජංගම දුරකථන සඳහා විශේෂිතව සකස් කළ 17px අකුරු මෝස්තරය.
        </p>

        <!-- Feature Pills -->
        <div class="flex flex-wrap gap-2.5 pt-2 text-xs text-[var(--reader-muted)]">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[var(--reader-bg)] border border-[var(--reader-border)]">
            <span>📱</span> <span>ජංගම දුරකථන කියවීම</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[var(--reader-bg)] border border-[var(--reader-border)]">
            <span>⚡</span> <span>වේගවත් Edge SSG</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[var(--reader-bg)] border border-[var(--reader-border)]">
            <span>🌙</span> <span>අඳුරු / ආලෝක තේමා</span>
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[var(--reader-bg)] border border-[var(--reader-border)]">
            <span>🔖</span> <span>ස්වයංක්‍රීය පිටුසන්</span>
          </span>
        </div>

        <!-- Quick Action CTAs -->
        <div class="flex flex-wrap items-center gap-3 pt-3">
          <a
            href="#novels-catalog"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl accent-bg font-semibold text-xs shadow-xs active:scale-95 transition-all"
          >
            <span>නවකතා කියවීම අරඹන්න</span>
            <span>↓</span>
          </a>
          <a
            href="/bookmarks"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[var(--reader-bg)] border border-[var(--reader-border)] hover:border-[var(--theme-accent)]/50 text-xs font-semibold text-[var(--reader-text)] active:scale-95 transition-all"
          >
            <span>🔖 මගේ කියවීම් ලැයිස්තුව (Bookmarks)</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Featured Novel Spotlight -->
    <section class="bg-[var(--reader-panel)] border border-[var(--reader-border)] rounded-3xl p-6 sm:p-8 shadow-sm transition-colors">
      <div class="flex flex-col md:flex-row gap-8 items-start">
        
        <!-- Book Cover Art with 2:3 aspect ratio -->
        <div class="w-full sm:w-64 md:w-72 shrink-0 mx-auto md:mx-0 group">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-[var(--reader-border)] aspect-[2/3] bg-neutral-900">
            <img
              src={featuredNovel.data.coverImage}
              alt={`Cover of ${featuredNovel.data.title}`}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute top-3 left-3">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold accent-bg backdrop-blur-md shadow-xs">
                <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
                විශේෂාංග නවකතාව
              </span>
            </div>
          </div>
        </div>

        <!-- Novel Metadata & Overview -->
        <div class="flex-1 space-y-4">
          <div>
            <div class="flex flex-wrap gap-2 mb-3">
              {featuredNovel.data.genres.map(genre => (
                <a
                  href={`/genres/${getGenreSlug(genre)}`}
                  class="px-2.5 py-1 rounded-lg text-xs font-medium bg-[var(--reader-border)]/40 text-[var(--reader-muted)] hover:accent-text border border-[var(--reader-border)]/60 transition-colors"
                >
                  {genre}
                </a>
              ))}
            </div>

            <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-[var(--reader-text)] leading-snug font-serif">
              <a href={`/novels/${featuredNovel.id}`} class="hover:accent-text transition-colors">
                {featuredNovel.data.title}
              </a>
            </h2>
            
            <p class="text-sm sm:text-base text-[var(--reader-muted)] mt-2">
              කර්තෘ: <a href={`/authors/${featuredNovel.data.authorSlug}`} class="accent-text font-semibold hover:underline">{featuredNovel.data.author}</a>
            </p>
          </div>

          <!-- Synopsis -->
          <div class="text-sm sm:text-base text-[var(--reader-text)]/90 leading-relaxed font-novel-sans border-l-2 border-[var(--theme-accent)]/50 pl-4 py-1 italic">
            "{featuredNovel.data.synopsis}"
          </div>

          <!-- Quick Stats -->
          <div class="grid grid-cols-3 gap-3 py-3 border-y border-[var(--reader-border)] text-center sm:text-left text-xs">
            <div>
              <div class="text-[11px] text-[var(--reader-muted)]">පරිච්ඡේද</div>
              <div class="text-base font-bold text-[var(--reader-text)]">{featuredChapters.length}</div>
            </div>
            <div>
              <div class="text-[11px] text-[var(--reader-muted)]">තත්ත්වය</div>
              <div class="text-base font-bold accent-text">
                {featuredNovel.data.status === 'Completed' ? 'සම්පූර්ණයි' : 'ලියවෙමින් පවතී'}
              </div>
            </div>
            <div>
              <div class="text-[11px] text-[var(--reader-muted)]">භාෂාව</div>
              <div class="text-base font-bold text-[var(--reader-text)]">සිංහල</div>
            </div>
          </div>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row gap-3 pt-2">
            <a
              href={featuredFirstChapterUrl}
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl accent-bg font-semibold text-sm shadow-md active:scale-95 transition-all text-center"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              <span>කියවීම අරඹන්න (1 වන පරිච්ඡේදය)</span>
            </a>

            <a
              href={`/novels/${featuredNovel.id}`}
              class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl bg-[var(--reader-border)]/40 hover:bg-[var(--reader-border)]/80 text-[var(--reader-text)] font-semibold text-sm border border-[var(--reader-border)] active:scale-95 transition-all text-center"
            >
              <span>පරිච්ඡේද නාමාවලිය</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

        </div>

      </div>
    </section>

    <!-- Catchy & Professional Novel Grid Catalog -->
    <section id="novels-catalog" class="space-y-6">
      
      <!-- Catalog Header & Filter Controls -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4 border-b border-[var(--reader-border)]">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--reader-text)] font-serif">
            සියලුම නවකතා
          </h2>
          <p class="text-xs sm:text-sm text-[var(--reader-muted)] mt-1">
            විවිධ කතුවරුන්ගේ සිංහල නවකතා නාමාවලිය
          </p>
        </div>

        <!-- Filter Segment: Status (All / Ongoing / Completed) -->
        <div class="flex flex-wrap items-center gap-2">
          <div class="flex p-1 rounded-xl bg-[var(--reader-panel)] border border-[var(--reader-border)] text-xs font-medium">
            <button
              data-filter-status="all"
              class="status-filter-btn px-3 py-1.5 rounded-lg accent-bg font-semibold shadow-xs transition-all"
            >
              සියලුම ({novels.length})
            </button>
            <button
              data-filter-status="Ongoing"
              class="status-filter-btn px-3 py-1.5 rounded-lg text-[var(--reader-muted)] hover:text-[var(--reader-text)] transition-all"
            >
              ලියවෙමින් පවතින
            </button>
            <button
              data-filter-status="Completed"
              class="status-filter-btn px-3 py-1.5 rounded-lg text-[var(--reader-muted)] hover:text-[var(--reader-text)] transition-all"
            >
              සම්පූර්ණ වූ
            </button>
          </div>

          <a
            href="/novels"
            class="hidden sm:inline-flex items-center gap-1 text-xs font-semibold accent-text hover:underline px-2.5 py-1.5 rounded-lg border border-[var(--reader-border)]"
          >
            <span>සම්පූර්ණ නාමාවලිය</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Quick Genre Pills Filter -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 text-xs scrollbar-none">
        <span class="text-[var(--reader-muted)] shrink-0 text-[11px] font-medium">වර්ගීකරණය:</span>
        <button
          data-filter-genre="all"
          class="genre-filter-btn px-3 py-1.5 rounded-xl accent-badge font-semibold shrink-0 transition-all border border-[var(--theme-accent)]/30"
        >
          සියලු වර්ග
        </button>
        {allGenres.map(g => (
          <button
            data-filter-genre={g}
            class="genre-filter-btn px-3 py-1.5 rounded-xl bg-[var(--reader-panel)] border border-[var(--reader-border)] text-[var(--reader-muted)] hover:text-[var(--reader-text)] shrink-0 transition-all"
          >
            {g}
          </button>
        ))}
      </div>

      <!-- Novels Grid: 2 columns on Mobile, 3 on Tablet, 4 on Desktop -->
      <div
        id="novels-grid-container"
        class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 gap-3.5 sm:gap-6"
      >
        {sortedNovels.map((novel) => (
          <NovelCard
            id={novel.id}
            title={novel.data.title}
            author={novel.data.author}
            authorSlug={novel.data.authorSlug}
            coverImage={novel.data.coverImage}
            synopsis={novel.data.synopsis}
            genres={novel.data.genres}
            status={novel.data.status}
            chapterCount={novelChapterCounts[novel.id] || 1}
          />
        ))}
      </div>

      <!-- Filter Empty State -->
      <div id="grid-empty-state" class="hidden py-16 text-center space-y-3 bg-[var(--reader-panel)] rounded-3xl border border-[var(--reader-border)]">
        <div class="text-3xl">📚</div>
        <h3 class="text-base font-bold text-[var(--reader-text)] font-serif">නවකතා හමු නොවීය</h3>
        <p class="text-xs text-[var(--reader-muted)]">තෝරාගත් වර්ගීකරණයට අදාළ නවකතා තවම නොමැත.</p>
        <button id="btn-reset-filters" class="text-xs font-semibold accent-text hover:underline">
          සියලුම නවකතා පෙන්වන්න
        </button>
      </div>
    </section>

    <!-- Multi-Author Roster Spotlight -->
    <section class="space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--reader-border)]">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--reader-text)] font-serif">
            අපගේ කතුවරුන්
          </h2>
          <p class="text-xs text-[var(--reader-muted)] mt-0.5">
            විවිධ ශෛලීන්ගෙන් නවකතා ලියන නිර්මාණශීලී ලේඛකයන්
          </p>
        </div>
        <a href="/authors" class="text-xs font-semibold accent-text hover:underline flex items-center gap-1">
          <span>සියලු කතුවරුන්</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {uniqueAuthors.map(author => {
          const authorNovels = novels.filter(n => n.data.authorSlug === author.slug);
          return (
            <div class="p-4 rounded-2xl bg-[var(--reader-panel)] border border-[var(--reader-border)] hover:border-[var(--theme-accent)]/50 transition-all flex items-center gap-3.5 group">
              <div class="w-12 h-12 rounded-xl accent-badge flex items-center justify-center font-bold text-base font-serif shrink-0 group-hover:scale-105 transition-transform">
                {author.name.charAt(0)}
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-sm sm:text-base text-[var(--reader-text)] group-hover:accent-text transition-colors truncate font-serif">
                  <a href={`/authors/${author.slug}`}>
                    {author.name}
                  </a>
                </h3>
                <p class="text-xs text-[var(--reader-muted)] mt-0.5">
                  නවකතා {authorNovels.length} ක් • <a href={`/authors/${author.slug}`} class="accent-text font-medium hover:underline">පැතිකඩ →</a>
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Latest Chapter Releases Feed -->
    <section class="space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--reader-border)]">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--reader-text)] font-serif">
            නවතම පරිච්ඡේද නිකුත් කිරීම්
          </h2>
          <p class="text-xs text-[var(--reader-muted)] mt-0.5">
            අවසන් වරට යාවත්කාලීන වූ පරිච්ඡේද පෙළ
          </p>
        </div>
        <a href="/rss.xml" class="text-xs font-medium text-amber-600 dark:text-amber-400 hover:underline flex items-center gap-1">
          <span>RSS Feed</span>
          <span>📡</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3.5">
        {latestChapters.map(chap => {
          const parentNovel = novels.find(n => n.id === chap.data.novel);
          return (
            <a
              href={`/novels/${chap.data.novel}/${chap.data.chapterNumber}`}
              class="p-4 rounded-2xl bg-[var(--reader-panel)] border border-[var(--reader-border)] hover:border-[var(--theme-accent)]/60 hover:-translate-y-0.5 transition-all flex flex-col justify-between gap-3 group"
            >
              <div>
                <div class="text-[11px] accent-text font-semibold uppercase tracking-wider mb-1">
                  {parentNovel?.data.title}
                </div>
                <h3 class="font-bold text-sm sm:text-base text-[var(--reader-text)] group-hover:accent-text transition-colors font-serif leading-snug line-clamp-1">
                  පරිච්ඡේදය {chap.data.chapterNumber}: {chap.data.title}
                </h3>
              </div>
              <div class="flex items-center justify-between text-[11px] text-[var(--reader-muted)] pt-2 border-t border-[var(--reader-border)]/50">
                <span>{chap.data.publishDate.toLocaleDateString('si-LK', { month: 'short', day: 'numeric' })}</span>
                <span class="accent-text font-medium group-hover:underline">කියවන්න →</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

  </div>

  <!-- Interactive Catalog Filter Script -->
  <script>
    // Interactive Frontpage Grid Filtering
    let currentStatus = 'all';
    let currentGenre = 'all';

    const cards = document.querySelectorAll('[data-novel-card]');
    const emptyState = document.getElementById('grid-empty-state');

    const filterGrid = () => {
      let visibleCount = 0;
      cards.forEach(card => {
        const cardStatus = card.getAttribute('data-status') || '';
        const cardGenres = (card.getAttribute('data-genres') || '').split(',');

        const matchesStatus = currentStatus === 'all' || cardStatus.toLowerCase() === currentStatus.toLowerCase();
        const matchesGenre = currentGenre === 'all' || cardGenres.some(g => g.trim() === currentGenre);

        if (matchesStatus && matchesGenre) {
          (card as HTMLElement).style.display = 'flex';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    };

    // Status Buttons
    document.querySelectorAll('[data-filter-status]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-filter-status]').forEach(b => {
          b.className = 'status-filter-btn px-3 py-1.5 rounded-lg text-[var(--reader-muted)] hover:text-[var(--reader-text)] transition-all';
        });
        btn.className = 'status-filter-btn px-3 py-1.5 rounded-lg accent-bg font-semibold shadow-xs transition-all';
        currentStatus = btn.getAttribute('data-filter-status') || 'all';
        filterGrid();
      });
    });

    // Genre Buttons
    document.querySelectorAll('[data-filter-genre]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-filter-genre]').forEach(b => {
          b.className = 'genre-filter-btn px-3 py-1.5 rounded-xl bg-[var(--reader-panel)] border border-[var(--reader-border)] text-[var(--reader-muted)] hover:text-[var(--reader-text)] shrink-0 transition-all';
        });
        btn.className = 'genre-filter-btn px-3 py-1.5 rounded-xl accent-badge font-semibold shrink-0 transition-all border border-[var(--theme-accent)]/30';
        currentGenre = btn.getAttribute('data-filter-genre') || 'all';
        filterGrid();
      });
    });

    document.getElementById('btn-reset-filters')?.addEventListener('click', () => {
      currentStatus = 'all';
      currentGenre = 'all';
      (document.querySelector('[data-filter-status="all"]') as HTMLElement)?.click();
      (document.querySelector('[data-filter-genre="all"]') as HTMLElement)?.click();
    });
  </script>
</BaseLayout>
