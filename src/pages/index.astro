---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const novels = await getCollection('novels');
const allChapters = await getCollection('chapters');

const sortedNovels = novels.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const featuredNovel = sortedNovels[0];

const chapterCounts: Record<string, number> = {};
allChapters.forEach(c => {
  chapterCounts[c.data.novel] = (chapterCounts[c.data.novel] || 0) + 1;
});

const latestChapters = [...allChapters]
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);

const featuredFirst = allChapters
  .filter(c => c.data.novel === featuredNovel.id)
  .sort((a, b) => a.data.chapterNumber - b.data.chapterNumber)[0];
const featuredStartUrl = featuredFirst
  ? `/novels/${featuredNovel.id}/${featuredFirst.data.chapterNumber}`
  : `/novels/${featuredNovel.id}`;

const statusLabel = (s: string) => (s === 'Completed' ? 'සම්පූර්ණයි' : 'ලියවෙමින්');
const formatDate = (d: Date) => d.toLocaleDateString('si-LK', { month: 'short', day: 'numeric' });
---

<BaseLayout
  title="කතා අරණ - සිංහල නවකතා කියවීමේ නිදහස් අවකාශය | Realm of Sinhala Web Novels"
  description="ශ්‍රී ලාංකේය ලේඛකයන්ගේ සිංහල නවකතා, අබිරහස්, ත්‍රාසජනක සහ ආදර කතා ජංගම දුරකථනයෙන් පහසුවෙන් කියවන්න. නොමිලේ, ගිණුම් අවශ්‍ය නැත."
  image={featuredNovel.data.coverImage}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <!-- Continue reading: filled from the reader's own history, hidden for first-time visitors -->
    <a id="continue-reading" href="#" class="hidden mt-6 items-center gap-4 py-3 border-b border-[var(--reader-border)] group">
      <span class="flex-1 min-w-0">
        <span id="continue-title" class="block font-serif font-semibold truncate group-hover:accent-text transition-colors"></span>
        <span id="continue-chapter" class="block text-sm text-[var(--reader-muted)]"></span>
      </span>
      <span class="text-sm font-semibold accent-text shrink-0">දිගටම කියවන්න</span>
    </a>

    <!-- Featured novel -->
    <section class="py-10 sm:py-14 grid sm:grid-cols-[220px_1fr] md:grid-cols-[260px_1fr] gap-8 md:gap-12 items-start">
      <a href={`/novels/${featuredNovel.id}`} class="block w-44 sm:w-full mx-auto sm:mx-0">
        <img
          src={featuredNovel.data.coverImage}
          alt={`${featuredNovel.data.title} කවරය`}
          class="w-full aspect-[2/3] object-cover rounded-md shadow-[0_12px_32px_-12px_rgba(0,0,0,0.45)]"
          loading="eager"
          fetchpriority="high"
        />
      </a>

      <div class="max-w-[38rem]">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-[1.35] text-balance">
          <a href={`/novels/${featuredNovel.id}`} class="font-serif hover:accent-text transition-colors">{featuredNovel.data.title}</a>
        </h1>
        <p class="mt-3 text-[var(--reader-muted)]">
          <a href={`/authors/${featuredNovel.data.authorSlug}`} class="text-[var(--reader-text)] font-medium hover:accent-text transition-colors">{featuredNovel.data.author}</a>
          <span aria-hidden="true"> · </span>{featuredNovel.data.genres.join(', ')}
        </p>
        <p class="mt-5 text-[1.0625rem] leading-[1.95]">{featuredNovel.data.synopsis}</p>
        <p class="mt-5 text-sm text-[var(--reader-muted)]">
          පරිච්ඡේද {chapterCounts[featuredNovel.id] || 0} · {statusLabel(featuredNovel.data.status)}
        </p>
        <div class="mt-6 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
          <a href={featuredStartUrl} class="accent-bg inline-flex justify-center items-center px-6 py-3 rounded-md font-semibold">
            කියවීම අරඹන්න
          </a>
          <a href={`/novels/${featuredNovel.id}`} class="text-center font-medium text-[var(--reader-muted)] hover:text-[var(--reader-text)] transition-colors">
            පරිච්ඡේද ලැයිස්තුව
          </a>
        </div>
      </div>
    </section>

    <!-- Latest chapters -->
    <section class="pt-10 border-t border-[var(--reader-border)]">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-bold">නවතම පරිච්ඡේද</h2>
        <a href="/rss.xml" class="text-sm text-[var(--reader-muted)] hover:text-[var(--reader-text)] transition-colors">RSS</a>
      </div>
      <ol class="mt-4">
        {latestChapters.map(chap => {
          const novel = novels.find(n => n.id === chap.data.novel);
          return (
            <li class="border-b border-[var(--reader-border)] last:border-b-0">
              <a href={`/novels/${chap.data.novel}/${chap.data.chapterNumber}`} class="flex items-center gap-4 py-4 group">
                <img src={novel?.data.coverImage} alt="" class="w-10 h-[3.75rem] object-cover rounded-sm shrink-0" loading="lazy" />
                <span class="flex-1 min-w-0">
                  <span class="block font-serif font-semibold truncate group-hover:accent-text transition-colors">{novel?.data.title}</span>
                  <span class="block text-sm text-[var(--reader-muted)] truncate">පරිච්ඡේදය {chap.data.chapterNumber}: {chap.data.title}</span>
                </span>
                <time datetime={chap.data.publishDate.toISOString()} class="text-sm text-[var(--reader-muted)] tabular-nums shrink-0">{formatDate(chap.data.publishDate)}</time>
              </a>
            </li>
          );
        })}
      </ol>
    </section>

    <!-- All novels -->
    <section id="novels-catalog" class="pt-14">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-bold">සියලුම නවකතා</h2>
        <a href="/novels" class="text-sm text-[var(--reader-muted)] hover:text-[var(--reader-text)] transition-colors">සියල්ල බලන්න</a>
      </div>
      <div class="mt-5 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-5 gap-y-8">
        {sortedNovels.map(novel => (
          <a href={`/novels/${novel.id}`} class="group block">
            <img
              src={novel.data.coverImage}
              alt={`${novel.data.title} කවරය`}
              class="w-full aspect-[2/3] object-cover rounded-md transition-shadow group-hover:shadow-[0_10px_24px_-10px_rgba(0,0,0,0.5)]"
              loading="lazy"
            />
            <span class="mt-3 block font-serif font-semibold leading-snug group-hover:accent-text transition-colors">{novel.data.title}</span>
            <span class="mt-0.5 block text-sm text-[var(--reader-muted)]">{novel.data.author}</span>
            <span class="mt-0.5 block text-sm text-[var(--reader-muted)]">පරිච්ඡේද {chapterCounts[novel.id] || 0} · {statusLabel(novel.data.status)}</span>
          </a>
        ))}
      </div>
    </section>
  </div>

  <script>
    try {
      const last = JSON.parse(localStorage.getItem('katha_history') || '[]')[0];
      const link = document.getElementById('continue-reading') as HTMLAnchorElement | null;
      if (last?.url && link) {
        link.href = last.url;
        if (last.novelCover) {
          link.prepend(Object.assign(new Image(), { src: last.novelCover, alt: '', className: 'w-9 h-[3.375rem] object-cover rounded-sm shrink-0' }));
        }
        document.getElementById('continue-title')!.textContent = last.novelTitle;
        document.getElementById('continue-chapter')!.textContent = `පරිච්ඡේදය ${last.chapterNumber} දක්වා කියවා ඇත`;
        link.classList.replace('hidden', 'flex');
      }
    } catch {}
  </script>
</BaseLayout>
