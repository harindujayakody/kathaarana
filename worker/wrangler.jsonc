{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kathaarana-api",
  "main": "src/index.js",
  // Randeepana@gmail.com's account, which owns the kathaarana.com zone.
  "account_id": "0426aaf804f668559bbdf8522547f783",
  "compatibility_date": "2026-05-01",
  // Same origin as the site, so the pages call /api/* with no CORS and no extra DNS.
  "routes": [
    { "pattern": "kathaarana.com/api/*", "zone_name": "kathaarana.com" },
    // Permanent redirects from the old /_astro/ file addresses (see src/legacy-assets.json).
    { "pattern": "kathaarana.com/_astro/*", "zone_name": "kathaarana.com" }
  ],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kathaarana",
      "database_id": "34da2ec3-bdca-4e45-ad12-5c963f7698c0"
    }
  ],
  "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    // Views are higher: many readers share one mobile-carrier IP.
    { "name": "VIEW_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "ALLOWED_ORIGINS": "https://kathaarana.com",
    "CATALOG_URL": "https://kathaarana.com/catalog.json"
  },
  "env": {
    // `wrangler dev --env dev` against the local Astro preview.
    "dev": {
      "vars": {
        "ALLOWED_ORIGINS": "http://localhost:4321",
        "CATALOG_URL": "http://localhost:4321/catalog.json"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "kathaarana", "database_id": "local" }],
      "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    // Views are higher: many readers share one mobile-carrier IP.
    { "name": "VIEW_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ]
    }
  }
}
