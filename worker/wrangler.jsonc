{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kathaarana-api",
  "main": "src/index.js",
  // Randeepana@gmail.com's account, which owns the kathaarana.com zone.
  "account_id": "0426aaf804f668559bbdf8522547f783",
  "compatibility_date": "2026-05-01",
  // Same origin as the site, so the pages call /api/* with no CORS and no extra DNS.
  "routes": [
    { "pattern": "kathaarana.com/api/*", "zone_name": "kathaarana.com" },
    // Permanent redirects from the old /_astro/ file addresses (see src/legacy-assets.json).
    { "pattern": "kathaarana.com/_astro/*", "zone_name": "kathaarana.com" },
    // Adds X-Robots-Tag: noindex to the story PDFs.
    { "pattern": "kathaarana.com/downloads/*", "zone_name": "kathaarana.com" },
    // Online publishing dashboard (src/admin.js), behind Cloudflare Access.
    { "pattern": "kathaarana.com/admin*", "zone_name": "kathaarana.com" }
  ],
  // The dashboard page (scripts/admin/index.html) is bundled as text.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kathaarana",
      "database_id": "34da2ec3-bdca-4e45-ad12-5c963f7698c0"
    }
  ],
  "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    // Views are higher: many readers share one mobile-carrier IP.
    { "name": "VIEW_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "ALLOWED_ORIGINS": "https://kathaarana.com",
    "CATALOG_URL": "https://kathaarana.com/catalog.json",
    // Dashboard: the repository it publishes to.
    // Secrets, set with `npx wrangler secret put <NAME>` and kept out of this public repo:
    //   GITHUB_TOKEN  fine-grained token, this repo only, Contents: read and write
    //   ACCESS_TEAM   Cloudflare Access team name (the part before .cloudflareaccess.com)
    //   ACCESS_AUD    the Access application's Audience (AUD) tag
    //   ADMIN_EMAILS  who may sign in, comma-separated
    // While any of the last three is missing, /admin refuses everyone.
    "GITHUB_REPO": "harindujayakody/kathaarana",
    // Dashboard stats from Cloudflare Web Analytics; needs the CF_ANALYTICS_TOKEN secret
    // (Account Analytics: Read). The account id is not secret.
    "CF_ACCOUNT_ID": "0426aaf804f668559bbdf8522547f783",
    "SITE_HOST": "kathaarana.com"
  },
  "env": {
    // `wrangler dev --env dev` against the local Astro preview.
    "dev": {
      "vars": {
        "ALLOWED_ORIGINS": "http://localhost:4321",
        "CATALOG_URL": "http://localhost:4321/catalog.json",
        "GITHUB_REPO": "harindujayakody/kathaarana",
        "CF_ACCOUNT_ID": "0426aaf804f668559bbdf8522547f783",
        "SITE_HOST": "kathaarana.com",
        // Skips sign-in on localhost only, for testing the dashboard with `wrangler dev`.
        "ADMIN_INSECURE_DEV": "1"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "kathaarana", "database_id": "local" }],
      "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    // Views are higher: many readers share one mobile-carrier IP.
    { "name": "VIEW_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ]
    }
  }
}
